@using BridgeWeb.Domain.Model.Dto.Budget

@model BridgeWeb.Domain.Model.MultipleModel
@{
    var LineItemsList = Model.GetLineItemsList ?? Enumerable.Empty<GetLineItemsDTO>();
    var total = LineItemsList.Sum(item => Math.Round(item.quantity * item.cost, 2));
    var totalCommit = LineItemsList.Sum(item => Math.Round(item.commit, 2));
    var index = 1;
    string FormatNumber(decimal number)
    {

        // Round the number to 2 decimal places first
        number = Math.Round(number, 2);

        // Format number with commas and ensure it's a string
        return number.ToString("#,0.00", System.Globalization.CultureInfo.InvariantCulture);
    }
}
<input type="hidden" value="@FormatNumber(Convert.ToDecimal(total))" id="totalForTable" />
<input type="hidden" value="@FormatNumber(Convert.ToDecimal(totalCommit))" id="totalCommitForTable" />

<table class="table table-striped table-hover line_table" id="line_table" cellspacing="0" style="width:100%;">
    <thead>
        <tr>
            <th>Actions</th>
            <th>Item#</th>
            <th>Description</th>
            <th>Spec</th>
            <th>Model</th>
            <th>Vendor</th>
            <th>Category</th>
            <th>Quantity</th>
            <th>UOM</th>
            <th>Cost</th>
            <th>Total</th>
            <th>Commit</th>
            <th>Remaining</th>
            <th class="rightposition">Adjust</th>
            <th>Variance</th>
            @* <th>Space</th> *@
            <th>Tax</th>
            <th>NonF</th>
        </tr>
    </thead>
    <tbody>
        @if (LineItemsList.Any())
        {

            @foreach (var items in LineItemsList)
            {
                <tr data-index="@index" data-order="@items.itemOrder">
                    <td class="line_firstcol">
                        <div class="action_icons">
                            @if (Model.LockStatus?.isBudgetLocked == 0)
                            {
                                <a href="#" data-bs-target="#edit_line_item" data-bs-toggle="modal" class="editLineItemsmodal" data-lineitemid="@items.lineItemID" data-freightval="@items.nonfrieght">
                                    <i class="fa-regular fa-pen-to-square" title="Edit Item"></i>
                                </a>
                                if (!string.IsNullOrWhiteSpace(items.poid) && !string.IsNullOrEmpty(items.poid))
                                {
                                    <a href="@Url.Content("/PurchaseOrder/POList?id=" + items.poid + "&projectId=" + items.projectId)" target="_blank"><i class="fa-solid fa-circle-info"></i></a>
                                }

                                <a href="#" class="deleteSingleLineItem" data-id="@items.lineItemID"><i class="fa-regular fa-trash-can" title="Delete Item"></i></a>
                                <a href="#" data-bs-target="#savnot" data-bs-toggle="modal" data-note="@items.note" data-lineitemidhidden="@items.lineItemID" class="editNote">
                                    @if (string.IsNullOrEmpty(items.note) || string.IsNullOrWhiteSpace(items.note))
                                    {
                                        <i class="fa-regular fa-comment"></i>
                                    }
                                    else
                                    {
                                        <i class="fa fa-commenting-o"></i>
                                    }

                                </a>
                            }
                            else
                            {
                                <a href="javascript:void(0);"><i class="fa-solid fa fa-lock"></i></a>
                                <a href="#" data-bs-target="#savnot" data-bs-toggle="modal" data-note="@items.note" data-lineitemidhidden="@items.lineItemID" class="editNote">
                                    @if (string.IsNullOrEmpty(items.note) || string.IsNullOrWhiteSpace(items.note))
                                    {
                                        @* <i class="fa-regular fa-comment"></i> *@
                                    }
                                    else
                                    {
                                        <i class="fa fa-commenting-o"></i>
                                    }

                                </a>
                            }

                        </div>
                    </td>
                    <td class="itemtotal leftposition">
                        @items.totalID
                    </td>
                    <td class="itmDesc leftposition">@items.itemDescriptions</td>
                    <td class="itmSpecNum leftposition">@items.specNum</td>
                    <td class="itmModel leftposition">@items.model</td>
                    <td class="itmVendor leftposition">@items.vendor</td>
                    <td class="itmheader leftposition">@items.header</td>
                    <td class="itmQty rightposition">@FormatNumber(Convert.ToDecimal(items.quantity))</td>
                    <td class="itmUOM leftposition">@items.uom</td>
                    <td class="itmCost rightposition">@FormatNumber(Convert.ToDecimal(items.cost))</td>
                    <td class="itmTotal rightposition">@FormatNumber(Convert.ToDecimal(items.quantity * items.cost)) </td>
                    <td class="itmCommit rightposition">@FormatNumber(Convert.ToDecimal(items.commit))</td>
                    <td class="itmRemaining rightposition">@FormatNumber(Convert.ToDecimal(Math.Max(Math.Round(items.quantity * items.cost, 2) - Math.Round(items.commit, 2) - (long)items.adjust, 0)))</td>
                    <td>
                        @if (Model.LockStatus?.isBudgetLocked == 0)
                        {
                            <input type="text" class="form-control uAdjust rightposition" data-lineitemid="@items.lineItemID"  data-adj="@Math.Round(@items.adjust, 0)" value="@Math.Round(@items.adjust, 0)">
                        }
                        else
                        {
                            <input type="text" class="form-control rightposition" data-lineitemid="@items.lineItemID" data-adj="@Math.Round(@items.adjust, 0)" value="@Math.Round(@items.adjust, 0)" disabled>
                        }
                    </td>

                    <td class="itmVariance rightposition">
                        @{
                            var budget_cost = Math.Round(items.quantity * items.cost, 2);
                            var remaining = Math.Max(Math.Round(budget_cost - items.commit - items.adjust, 2), 0);
                            var variance = Convert.ToDecimal(Math.Max(
                            Math.Round(budget_cost - items.commit - remaining, 2),
                            budget_cost - items.commit - remaining - items.adjust
                            ));
                        }
                        @FormatNumber(variance)
                    </td>
                    @* @if (items.spacing == 0)
                    {
                        <td class="itmSpc" style="color:rgb(139, 147, 229);cursor:pointer;" data-id="@items.lineItemID">No</td>
                    }
                    else
                    {
                        <td class="itmSpc" style="color:rgb(139, 147, 229);cursor:pointer;" data-id="@items.lineItemID">Yes</td>
                    } *@
                    @if (items.taxable == false)
                    {
                        <td class="itmTx" style="color:rgb(139, 147, 229);cursor:pointer;" data-id="@items.lineItemID">No</td>

                    }
                    else
                    {
                        <td class="itmTx" style="color:rgb(139, 147, 229);cursor:pointer;" data-id="@items.lineItemID">Yes</td>
                    }
                    <td class="itmnonfrieght">@items.nonfrieght</td>

                </tr>
                index++;
            }
        }
        else
        {

        }


    </tbody>
</table>


