<div class="modal fade" id="add_budget_tab" tabindex="-1" aria-labelledby="budgetModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title">Add Budget Items</h1>
                <button type="button" class="modal-close" data-bs-dismiss="modal" aria-label="Close">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>
            <div class="modal-body">

                <form acion="#" id="add_budget_lineitem_modal_form">
                    @Html.AntiForgeryToken()
                    <div class="row">
                        <div class="col-md-6">
                            <div class="frm_fld_wrp">
                                <label for="" class="form-label">Description<span class="req">*</span></label>
                                <input type="text" class="form-control" id="itemdescription" placeholder="Enter Description">
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="frm_fld_wrp">
                                <label for="" class="form-label">Spec #</label>
                                <input type="text" class="form-control" id="specnum" placeholder="Spec #">
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="frm_fld_wrp">
                                <label for="" class="form-label">Model</label>
                                <input type="text" class="form-control" id="modelno" placeholder="Enter Model">
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="frm_fld_wrp">
                                <label for="" class="form-label">Vendor</label>
                                <input type="text" class="form-control" id="vendor" placeholder="Enter Vendor">
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="frm_fld_wrp">
                                <label for="" class="form-label">Category</label>
                                <input type="text" class="form-control" id="itemheader" placeholder="Enter Category">
                            </div>
                        </div>
                        <div class="col-md-2">
                            <div class="frm_fld_wrp">
                                <label for="" class="form-label">Quantity</label>
                                <input type="number" class="form-control right-txt" id="itemquantity" value="0.00">
                            </div>
                        </div>
                        <div class="col-md-2">
                            <div class="frm_fld_wrp">
                                <label for="" class="form-label">Cost</label>
                                <input type="number" class="form-control right-txt" id="cost" value="0.00">
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="frm_fld_wrp">
                                <label for="" class="form-label">UOM</label>
                                <select name="" id="uomdd" class="form-select">
                                    @{
                                        var AllOUMDetailsListInBudgetDetails = Model.AllOUMDetailsListInBudgetDetails ?? new List<AllOUMDetailsDTO>();
                                        if (AllOUMDetailsListInBudgetDetails.Any())
                                        {
                                            foreach (var items in AllOUMDetailsListInBudgetDetails)
                                            {
                                                if (items.UOM_ID == 56)
                                                {
                                                    <option value="@items.UOM_ID" selected>@items.UOM</option>
                                                }
                                                else
                                                {
                                                    <option value="@items.UOM_ID">@items.UOM</option>
                                                }
                                            }

                                        }
                                    }

                                </select>
                            </div>
                        </div>

                        <div class="col-md-5">
                            <div class="frm_fld_wrp">
                                <label for="" class="form-label">Notes</label>
                                <input type="text" class="form-control" id="notes" placeholder="Enter notes">
                            </div>
                        </div>

                        <div class="col-md-6">
                            @*<div class="budget_check_wrp">
                                
                            </div>*@
                            <label for="taxable">Taxable? <input type="checkbox" name="" id="taxable" checked></label>
                            <label for="duty">Freight/Duty? <input type="checkbox" name="" id="duty"></label>

                        </div>


                    </div>
                </form>


            </div>
            <div class="modal-footer">
                <button type="button" class="gray_checkbtn" id="btn_CreateBudget">Add Items</button>
            </div>
        </div>
    </div>
</div>