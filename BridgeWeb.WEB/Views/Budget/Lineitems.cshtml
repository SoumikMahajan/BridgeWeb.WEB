@using BridgeWeb.Domain.Model.Dto.Budget
@{
    ViewData["Title"] = "LineItems";
}
@model BridgeWeb.Domain.Model.MultipleModel
@{
    var previousProjectID = ViewBag.PreviousSelected ?? "0";
}
<!-- breadcrumb -->
<div class="bread_cumb_wrp">
    <div class="container-fluid">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="@Url.Action("Dashboard", "Home")">Home</a></li>
                <li class="breadcrumb-item"><a href="@Url.Action("Lineitems", "Budget")">BUDGETS</a></li>
                <li class="breadcrumb-item active" aria-current="page"><span>DETAIL</span></li>
            </ol>
        </nav>
    </div>
</div>
<!-- breadcrumb -->
<!-- flote icon -->
<div class="flote_icon">
    <ul>
        <li>
            <a href="#" data-bs-toggle="popover" data-bs-content="Copy Budget" data-bs-trigger="hover">
                <i class="fa-regular fa-copy" data-bs-toggle="modal" data-bs-target="#copybudget" id="btn_CopyBudget"></i>
            </a>
        </li>
    </ul>
</div>
<!-- flote icon -->
<!-- Budget Detail-->
@* <input type="hidden" value="" id="previousSelectedProject"/> *@
<input type="hidden" id="IsBudgetApproved" value="" />
<input type="hidden" id="IsBudgetLocked" value="" />
<input type="hidden" id="IsSentForApproval" value="" />
<input type="hidden" id="VersionNumberForApproval" value="" />
<input type="hidden" id="Currentversion" value="" />
<input type="hidden" id="IsBudgetChanged" value="" />
<input type="checkbox" id="chk_VrsnCrt" value="" class="d-none" />
<input type="hidden" id="cansendforapproval" value="true" />

<section class="master_wrap budget_sec budget_dtl_footer_fixed">
    <div class="container-fluid">
        <div class="budget_detail_wrp">
            <h2 class="section_header">Budget Detail</h2>
            <div class="row">
                <div class="col-lg-3">
                    <div class="multi_slc_wrp">
                        <label for="Project_Name_List" class="form-label">Select Project<span class="req">*</span></label>
                        <select multiple="multiple" class="multislct" data-width="100%" id="Project_Name_List">
                            @{
                                var ProjectNameDropDown = Model.ProjectNameDropDown ?? new List<ProjectDropDownListDTO>();
                                if (ProjectNameDropDown.Any())
                                {
                                    <!option value="0" data-id="0" selected>--Select Project--</!option>
                                    @foreach (var item in ProjectNameDropDown)
                                    {

                                        if (item.ProjectID == Model.SelectedProjectID)
                                        {
                                            // <option value="@item.ProjectID" data-id="@item.ProjectID">@item.ProjectName</option>//
                                            <option value="@item.ProjectID" data-id="@item.ProjectID" selected>
                                                @item.ProjectName
                                            </option>
                                        }
                                        else
                                        {
                                            <option value="@item.ProjectID" data-id="@item.ProjectID">
                                                @item.ProjectName
                                            </option>
                                        }
                                    }
                                }
                            }
                        </select>
                    </div>
                </div>

                <div class="col-lg-3">
                    <div class="frm_fld_wrp">
                        <label class="form-label">
                            Select Version <i class="fa-solid fa-pencil" id="editCV"></i> <i class="fa-solid fa-trash-can" id="deleteCV"></i>
                        </label>
                        <div id="currentVersion"></div>

                    </div>
                </div>

                <div class="col-lg-1">
                    <div class="history_btns">
                        <i class="fa fa-history" data-bs-target="#approval_history" data-bs-toggle="modal" id="approvalHistory" title="View Approval History"></i>
                        <i class="fa fa-info-circle" data-bs-target="#budget_history" data-bs-toggle="modal" id="budgetHistory" title="View Budget History"></i>
                    </div>
                </div>

                <div class="col-lg-3">
                    <div class="multi_slc_wrp">
                        <label class="form-label" id="labelProject">Select Section</label>
                        <div id="ProjectSectionList"></div>
                    </div>
                </div>

                <div class="col-lg-2">
                    @* <button class="add_budget_btn collapsed" type="button" data-bs-toggle="collapse"
                            data-bs-target="#add_budget_tab" aria-expanded="false" aria-controls="add_budget_tab" id="addBudgetBtn">
                        <i class="fa-solid fa-plus"></i>
                        <i class="fa-solid fa-minus"></i>
                        Add Budget Items
                    </button> *@
                    <button class="add_budget_btn" type="button" data-bs-toggle="modal"
                            data-bs-target="#add_budget_tab" aria-expanded="false" aria-controls="add_budget_tab" id="addBudgetBtn">
                        Add Budget Items
                    </button>
                </div>


            </div>
        </div>

        <div class="line_itmes">
            <h2 class="section_header">
                <i class="fa-solid fa-magnifying-glass-plus" id="MagnifyPlus" title="Zoom In"></i>
                LINE ITEMS
                <i class="fa-solid fa-magnifying-glass-minus" id="MagnifyMinus" title="Zoom Out"></i>
            </h2>
            <div class="adj_btn">
                <ul class="d-none" id="btns">
                    <li id="deleteSelection"><i class="fa fa-trash-o"></i> Delete selected Items</li>
                    <li id="cancelSelectionBtn"><i class="fa fa-times-circle"></i> Cancel all selections</li>
                </ul>
                <button type="button" class="gray_checkbtn" id="AdjustRemaining">Adjust All Remaining</button>
            </div>
            <div id="lineItemsTable"></div>

        </div>

        <div class="btm_fxd_sec">
            <div class="ess_btn">
                <button type="button" class="gray_checkbtn" id="btnExporToExcel">Export to Excel</button>
                <button type="button" class="gray_checkbtn" id="lckbtn">Lock Budget</button>
                <div class="dropdown unlock_budget">
                    <button class="gray_checkbtn dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false" id="unlockbtn">
                        Unlock Budget
                    </button>
                    <ul class="dropdown-menu">
                        <li>
                            <a class="dropdown-item" href="#">
                                <span id="unlockyes">Yes</span> <input type="text" placeholder="Name for new version" id="newversionname">
                            </a>
                        </li>
                        <li><a class="dropdown-item isapproved" href="#" id="unlckno">No</a></li>
                    </ul>
                </div>
                <button type="button" class="gray_checkbtn" id="svsndAprvl">Save and Send for approval</button>
            </div>
            <form action="#" id="ImportExportLineItems">
                <div class="file_up">
                    <input type="file" name="file" id="FileUpload">
                    <button type="button" class="offwhite_btn" id="UpldLineItems">Upload</button>
                </div>
                <div class="down_format">
                    <a href="@Url.Content("~/assets/samples/budgetitemuploadformatguide.xlsx")">Download Format Guide</a>
                </div>
            </form>
        </div>
    </div>
</section>
<!-- Budget Detail-->
