@using BridgeWeb.Domain.Model.Dto.Budget
@model BridgeWeb.Domain.Model.MultipleModel
@{
    var PreviousSectionList = Model.PreviousSectionList ?? new List<PreviousSectionListDTO>();
    var minSectionOrder = PreviousSectionList.Min(s => s.SectionOrder);
}
<select multiple="multiple" class="multislct" data-width="100%" id="PreviousProjectSection">
    @foreach (var items in PreviousSectionList)
    {
        if (minSectionOrder == items.SectionOrder)
        {
            <option value="@items.BudgetSectionID" selected>@items.Sectionnumber @items.Name</option>
        }
        else
        {
            <option value="@items.BudgetSectionID">@items.Sectionnumber @items.Name</option>
        }

    }


</select>