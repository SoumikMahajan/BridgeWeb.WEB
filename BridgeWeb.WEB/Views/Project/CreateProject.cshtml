                    </nav>
                </div> *@
            </div>

            <div class="modal-footer">
                <button type="button" class="gray_checkbtn" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="polist" tabindex="-1" aria-labelledby="polist" aria-hidden="true">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title">PO Comment List</h1>
                <button type="button" class="modal-close" data-bs-dismiss="modal" aria-label="Close">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>
            <div class="modal-body">

               
                <div class="" id="POCommentList">
                </div>

                @* <div class="pagination_wrp">
                    <div class="dataTables_info">Showing 1 - 50 out of 82 entries</div>
                    <nav aria-label="Page navigation">
                        <ul class="pagination">
                            <li class="page-item"><a class="page-link disabled" href="#">Previous</a></li>
                            <li class="page-item"><a class="page-link current-page" href="#">1</a></li>
                            <li class="page-item"><a class="page-link" href="#">2</a></li>
                            <li class="page-item"><a class="page-link" href="#">Next</a></li>
                        </ul>
                    </nav>
                </div> *@

            </div>
            <div class="modal-footer">
                <button type="button" class="gray_checkbtn" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

