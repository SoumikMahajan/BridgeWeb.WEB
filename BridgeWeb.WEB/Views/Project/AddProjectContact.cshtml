@{
    ViewData["Title"] = "Add Project Contact";
}

@model BridgeWeb.Domain.Model.MultipleModel
<!-- breadcrumb -->
<input type="hidden" value="@ViewBag.ProjectId" id="projectIdinPC"/>
<div class="bread_cumb_wrp">
    <div class="container-fluid">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="@Url.Action("Dashboard", "Home")">Home</a></li>
                <li class="breadcrumb-item"><a href="@Url.Action("Projectlist", "Project")">Projects</a></li>
                <li class="breadcrumb-item active" aria-current="page"><span>ADD PROJECT CONTACTS</span></li>
            </ol>
        </nav>
    </div>
</div>
<!-- breadcrumb -->
<!-- edit project list-->
<section class="master_wrap add-projectContact">
    <div class="container-fluid">
        <div class="row">
            <div class="col-lg-6">
                <h2 class="section_header">ADD PROJECT CONTACTS</h2>
                <button type="button" class="gray_checkbtn" onclick="window.location.href='@Url.Action("EditProject", "Project", new { ProjectId = @ViewBag.ProjectId })'">Go to Project Page</button>
                <form class="row custom_gutter5-x" id="add_project_contact_form">
                    @Html.AntiForgeryToken()
                    <div class="col-lg-4">
                        <div class="frm_fld_wrp">
                            <label class="form-label">Contact Type<span class="req">*</span></label>
                            <select id="user_typeCreate" class="form-select">
                                <option value="0">--Select ContactType--</option>
                                @foreach (var type in Model.contactTypesList)
                                {
                                    <option value="@type.ContactTypeID">@type.ContactType</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="col-lg-4">
                        <div class="frm_fld_wrp">
                            <label class="form-label">Contact Name<span class="req">*</span></label>
                            <input type="text" class="form-control" id="nameContact">
                        </div>
                    </div>
                    <div class="col-lg-4">
                        <div class="frm_fld_wrp">
                            <label class="form-label">Email Address</label>
                            <input type="email" class="form-control" id="addEmail">
                        </div>
                    </div>

                    <div class="col-lg-6">
                        <div class="frm_fld_wrp">
                            <label for="address" class="form-label">Address</label>
                            <textarea class="form-control" id="address" rows="4" style="height: 90px;" ></textarea>
                        </div>
                        <div class="frm_fld_wrp">
                            <label class="form-label">City</label>
                            <input type="text" class="form-control" id="addCity">
                        </div>
                    </div>

                    <div class="col-lg-6">
                        <div class="frm_fld_wrp">
                            <label class="form-label">Country</label>
                            <select id="countryInAdd" class="form-select">
                                <option >--Select Country--</option>
                                @foreach (var country in Model.CountryList)
                                {
                                    <option value="@country.CountryID">@country.Country</option>
                                }
                            </select>
                        </div>

                        <div class="frm_fld_wrp">
                            <label class="form-label">State</label>
                            <select id="state" class="form-select">
                                <option value="0">--Select State--</option>
                            </select>
                        </div>

                        <div class="frm_fld_wrp">
                            <label class="form-label">Postal/Zip Code</label>
                            <input type="text" class="form-control" id="postalCode">
                        </div>
                    </div>

                    <div class="col-lg-3">
                        <div class="frm_fld_wrp">
                            <label class="form-label">Phone</label>
                            <input type="text" class="form-control" id="telePhone">
                        </div>
                    </div>
                    <div class="col-lg-3">
                        <div class="frm_fld_wrp">
                            <label class="form-label">Phone Extension</label>
                            <input type="text" class="form-control" id="extension">
                        </div>
                    </div>
                    <div class="col-lg-3">
                        <div class="frm_fld_wrp">
                            <label class="form-label">Mobile</label>
                            <input type="text" class="form-control" id="mobile">
                        </div>
                    </div>
                   @*  <div class="col-lg-3">
                        <div class="frm_fld_wrp">
                            <label class="form-label">Fax</label>
                            <input type="text" class="form-control" id="addFax">
                        </div>
                    </div> *@
                </form>
            </div>
        </div>
    </div>
</section>
<!-- edit project list-->
<!-- flote icon -->
<div class="flote_icon">
    <ul>
        <li>
            <a href="#" class="global-popover" data-bs-toggle="popover" data-bs-trigger="hover"
               data-bs-content="Save Contact" id="AddProjectContactSave">
                <i class="fa-regular fa-floppy-disk"></i>
            </a>
        </li>
    </ul>
</div>
<!-- flote icon -->
