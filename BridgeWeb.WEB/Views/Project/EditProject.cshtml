            <div class="row custom_gutter5-x">
                <div class="col-12">
                    <h2 class="section_header">PROJECT ATTACHMENTS (SELECT TO MAKE AVAILABLE AS PO ATTACHMENT)</h2>
                    <div class="row custom_gutter5-x">
                        <div class="col-lg-6">
                            <div class="project_attachments">
                                <fieldset>
                                    <legend>Project Attachments</legend>
                                    <div class="fileinput-button transparent_file">
                                        <p>Drop a file or click here to upload!</p>
                                        <input type="file" id="ProjectAttachmentFileUpload" names="files[]" multiple>
                                    </div>
                                    <div class="files_selected">
                                        <p>Files selected :</p>
                                        <ul class="filelist">
                                            @* <li class="filesul">FabricationStatus.pdf<input type="button" class="delfile" onclick="delobject3(&quot;fileupload0&quot;,this)"></li>
                                        <li class="filesul">FabricationStatus.pdf<input type="button" class="delfile" onclick="delobject3(&quot;fileupload0&quot;,this)"></li> *@
                                        </ul>
                                    </div>
                                </fieldset>
                            </div>
                        </div>
                        <div class="col-lg-6">
                            <div class="search_attactment" id="projectfilelistdiv">
                                <input type="text" class="form-control" id="searchFiles" placeholder="search attachments">
                                @{
                                    var poFileNames = new List<string>(
                                    (Model.POfilestoShowList ?? Enumerable.Empty<POFilesToshowDTO>())
                                    .Select(p => p.FileName)
                                    .Where(f => !string.IsNullOrWhiteSpace(f))!
                                    );
                                    var projectFiles = (Model.ProjectEdit.ProjectFile ?? string.Empty).Split(",").Where(x => !string.IsNullOrWhiteSpace(x) && !poFileNames.Contains(x)).ToList();
                                }
                                <input id="projectFilesCount" value="@projectFiles.Count" hidden />
                                <ul class="previousfilelist">

                                    @if (projectFiles.Count > 0)
                                    {

                                        @foreach (var files in projectFiles)
                                        {
                                            <li>
                                                <input type="checkbox" name="fileCheckbox" id="previous)">
                                                <a href="@Url.Content("~/Assets/ProjectFiles/" + files)" target="_blank">@files</a>
                                                <i class="fa fa-trash-o mrg5L deleteFile" style="cursor:pointer;" data-filename="@files" data-fldid=""></i>
                                            </li>

                                        }
                                        @if (poFiles.Any())
                                        {
                                            @foreach (var item in poFiles)
                                            {
                                                <li>
                                                    <input type="checkbox" checked>
                                                    <a href="@Url.Content("~/Assets/ProjectFiles/" + item)" target="_blank">@item.FileName</a>
                                                    <i class="fa fa-trash-o mrg5L deleteFile" style="cursor:pointer;" data-filename="@item.FileName" data-fldid="@item.FldID"></i>
                                                </li>
                                            }
                                        }
                                        else
                                        {
                                            <li></li>
                                        }
                                    }
                                    else if (projectFiles.Count == 0 && poFiles.Any())
                                    {
                                        @foreach (var item in poFiles)
                                        {
                                            <li>
                                                <input type="checkbox" checked>
                                                <a href="@Url.Content(" ~/Assets/ProjectFiles/" + item)" target="_blank">@item.FileName</a>
                                                <i class="fa fa-trash-o mrg5L deleteFile" style="cursor:pointer;" data-filename="@item.FileName" data-fldid="@item.FldID"></i>
                                            </li>
                                        }
                                    }
                                    else
                                    {
                                        <li></li>
                                    }





                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row custom_gutter5-x gy-2">
                <div class="col-lg-6">
                    <div class="pcomment">
                        <h2 class="section_header">PURCHASE ORDER COMMENTS</h2>
                        <div class="frm_fld_wrp add_fld">
                            <label for="">
                                Comment <a href="#" id="POModal">
                                    PO Comment
                                    List
                                </a>
                            </label>
                            <textarea class="form-control" placeholder="Purchase Order Comments" id="txt_PrchsOrdrCmmnts">@Model.ProjectEdit.PurchaseOrderComment</textarea>
                        </div>
                    </div>
                </div>

                <div class="col-lg-6">
                    <div class="project_comments">
                        <h2 class="section_header">PROJECT COMMENTS</h2>
                        <div class="row custom_gutter5-x gy-2">
                            <div class="col-xl-6">
                                <div class="frm_fld_wrp add_fld">
                                    <label for="">Enter Comment</label>
                                    <textarea class="form-control" placeholder="Enter Comment" id="newcomment"></textarea>
                                </div>
                                <button type="button" class="solid_teal_btn inline_solid_btn" id="AddProjectcomment">Add New</button>
                            </div>
                            <div class="col-xl-6">
                                @if (Model.ProjectCommentByProjectIdList != null && Model.ProjectCommentByProjectIdList.Any())
                                {
                                    <ul class="comment_list">


                                        @foreach (var item in Model.ProjectCommentByProjectIdList)
                                        {
                                            <li>
                                                <span>@item.Comment ( @item.CreatedDate )</span>
                                                <a href="#" class="remove_bar deleteProjectcommetInEditP" title="Remove this comment " data-id="@item.CommentId"><i class="fa-solid fa-xmark"></i></a>
                                            </li>
                                        }
                                    </ul>
                                }
                                else
                                {
                                    <div></div>

                                }



                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="project_contact_list">
                <h2 class="section_header">PROJECT CONTACT LIST</h2>



                <div class="table-responsive" id="ProjectContactListTable">
                </div>


            </div>
        </form>
    </div>
    <div class="modal fade po_comment_list" id="po_comment_list" tabindex="-1" aria-labelledby="exampleModalLabel"
         aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h1 class="modal-title">PO Comment List</h1>
                    <button type="button" class="modal-close" data-bs-dismiss="modal" aria-label="Close">
                        <i class="fa-solid fa-xmark"></i>
                    </button>
                </div>

                <div class="modal-body">

                    <div class="" id="POComment">
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="offwhite_btn" data-bs-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>
</section>
