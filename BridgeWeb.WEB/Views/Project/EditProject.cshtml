                                                    <li id="InstallationScheduleFiledata"><a href="@Url.Content("~/Assets/InstallationScheduleFiles/" + items)" target="_blank">@items</a> <i class="fa-solid fa-trash-can deleteISF" style="cursor:pointer;" data-fldid="0" data-filename="@items"></i></li>
                                                }

                                            }
                                            @* else
                                        {
                                            <li id="InstallationScheduleFiledata"><a href="" target="_blank"></a> <i class="fa-solid fa-trash-can"></i></li>
                                        } *@

