                                        <input type="file" id="TermsFileUpload" names="files[]" multiple>
                                    </div>
                                    <div class="files_selected TermsFiles">
                                        @*  <p>Files selected :</p> *@
                                        <ul class="filelist">
                                            @* <li class="filesul">FabricationStatus.pdf<input type="button" class="delfile" onclick="delobject3(&quot;fileupload0&quot;,this)"></li>
                                        <li class="filesul">FabricationStatus.pdf<input type="button" class="delfile" onclick="delobject3(&quot;fileupload0&quot;,this)"></li> *@
                                        </ul>
                                    </div>
                                    <div class="files_list">
                                        <p>Attached Files :</p>
                                        @{
                                            var termsFile = (Model.ProjectEdit.TermsFile ?? string.Empty).Split(",").Where(x => !string.IsNullOrWhiteSpace(x)).ToList();
                                            var defaultTermsFile = Model.ProjectEdit.DefaultTermsFile;
                                        }
                                        <input id="totalTermsFileCount" value="@termsFile.Count" hidden />
                                        <ul>
                                            @if (termsFile.Count > 0)
                                            {
                                                @foreach (var items in termsFile)
                                                {
                                                    <li id="TermsFiledata">
                                                        <a href="@Url.Content("~/Assets/TermsConditionFiles/" + items)" target="_blank" data-filename="@items">@items</a> <i class="fa-solid fa-trash-can deleteTermsFile" style="cursor:pointer;" data-filename="@items" data-fldid="0"></i>
                                                    </li>

                                                }
                                            }
                                            else
                                            {
                                                <li id="TermsFiledata">
                                                    <a href="@Url.Content("~/Assets/SystemTermsFiles/" + defaultTermsFile)" target="_blank">@TrimText(defaultTermsFile)</a>
                                                </li>
                                            }


                                        </ul>
                                    </div>
                                </div>
                            </fieldset>
                        </div>
                    </div>
                </div>
