@using BridgeWeb.Domain.Model.Dto
@using BridgeWeb.Domain.Model.Dto.Project
@{
    ViewData["Title"] = "Edit Project";
}

@model BridgeWeb.Domain.Model.MultipleModel
@{
    var project = Model.ProjectEdit
        ?? throw new InvalidOperationException("ProjectEdit is null");

    var ReportAccessPermissionDto = Model.ReportAccessPermissionDto
        ?? throw new InvalidOperationException("ReportAccessPermissionDto is null");

    var currencyList = Model.currencyList
        ?? throw new InvalidOperationException("currencyList is null");

    var countries = Model.CountryList ?? Enumerable.Empty<CountryDto>();

    var states = Model.StateList ?? Enumerable.Empty<StateDto>();

    long selectedStateId = 0;
    if (project.InvoiceState.HasValue)
    {
        selectedStateId = project.InvoiceState.Value;
    }

    long selectedCountryId = 0;

    if (!string.IsNullOrWhiteSpace(project.HotelCountry))
    {
        long.TryParse(project.HotelCountry, out selectedCountryId);
    }

    long selectedOwnerCountryId = 0;
    if (!string.IsNullOrWhiteSpace(project.OwnerCountry))
    {
        long.TryParse(project.OwnerCountry, out selectedOwnerCountryId);
    }

    var poFiles = Model.POfilestoShowList ?? Enumerable.Empty<POFilesToshowDTO>();

    string FormatNumber(decimal? number)
    {
        // Round the number to 2 decimal places first
        var value = Math.Round(number ?? 0m, 2);

        // Format number with commas and ensure it's a string
        return value.ToString("#,0.00", System.Globalization.CultureInfo.InvariantCulture);
    }
    ;

    string TrimText(string? str)
    {
        if (string.IsNullOrEmpty(str))
            return string.Empty;

        if (str.Length > 30)
        {
            return str.Substring(0, 15) + "..." + str.Substring(str.Length - 10);
        }

        return str;
    }
}
