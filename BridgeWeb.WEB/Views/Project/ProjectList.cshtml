@model BridgeWeb.Domain.Model.MultipleModel
@{
    ViewData["Title"] = "Project List";
}

<!-- breadcrumb -->
<div class="bread_cumb_wrp">
    <div class="container-fluid">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="@Url.Action("Dashboard", "Home")">Home</a></li>
                <li class="breadcrumb-item"><a href="@Url.Action("Projectlist", "Project")">Projects</a></li>
                <li class="breadcrumb-item active" aria-current="page"><span>Project List</span></li>
            </ol>
        </nav>
    </div>
</div>
<!-- breadcrumb -->
<!-- projects list-->
<section class="master_wrap">
    <div class="container-fluid">
        <h2 class="section_header">PROJECT LIST</h2>
        @* <div id="projectListTable"></div> *@
        <div class="table-responsive" id="projectListTable">

            <table id="project_list" class="table table-striped table-hover project_list" style="width:100%">

                <thead>
                    <tr>
                        <th>Action</th>
                        <th>Project</th>
                        <th>Name</th>
                        <th>Legal Name</th>
                        <th>Project Manager</th>
                        <th>Hotel City</th>
                        <th>Country</th>
                        <th>Mobile</th>
                        <th>Email</th>
                        <th>Status</th>
                    </tr>
                </thead>
            </table>

        </div>
    </div>
</section>
