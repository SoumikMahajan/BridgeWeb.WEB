
@model BridgeWeb.Domain.Model.MultipleModel
@{
    var index = 0;
}
<table class="table table-striped table-hover POCommentListTable" id="POCommentListTable" style="width:100%">
    <thead>
        <tr>
            <th></th>
            <th >                
              Project Number                
            </th>
            <th >                
               Project Name               
            </th>
            <th>
                Comment
            </th>
        </tr>      
    </thead>
   
    <tbody >
        @foreach(var item in Model.ProjectCommentsList)
        {
            <tr>
                <td style="cursor:pointer;">
                    <i class="fa-solid fa-hand-point-right hand-right hand-right insertComment" data-index="@index" aria-hidden="true" style="cursor:pointer;"></i>
                        <input type="hidden" class="hiddenComment" data-index="@index" value="@item.PurchaseOrderComment" />                   
                </td>
                <td>
                    @item.ProjectNumber
                </td>
                <td>
                    @item.ProjectName              
                </td>
                <td>
                    @item.PurchaseOrderComment.Trim()                   
                </td>
            </tr>
            index++;           
        }       
    </tbody>
</table>