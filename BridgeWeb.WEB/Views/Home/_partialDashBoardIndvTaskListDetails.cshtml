@model BridgeWeb.Domain.Model.MultipleModel

@{
    var UserRoleId = Model.UserRoleid;
    var UserId = Model.UserId;
    var UserName = Model.UserName;
    var IsPoEditAccessPermission = @ViewBag.IsEditable ?? "0";
}

@{
    if (Model.DashboardActionName == "buildIncompletePONew")
    {
        if (Model.incompletePoDTO.Count > 0)
        {
            var firstItem = Model.incompletePoDTO.First();
            var ItemCount = Model.incompletePoDTO.Count;
            var SelectedProjectId = firstItem.ProjectID ?? 0;

            <input type="hidden" id=@($"INCINFO_{SelectedProjectId}_Count") data-itemcount="@ItemCount" />
            foreach (var item in Model.incompletePoDTO)
            {
                <div class="accspan">
                    PO Number :
                    @if (IsPoEditAccessPermission == "0")
                    {
                        <a style="cursor:pointer;" href="javascript:void(0)" data-poid="@item.PurchaseOrderID" class="green_link ProffPO">
                            @item.PONumber
                        </a>                                                           
                    }
                    else
                    {
                        <a href="@Url.Action("POEdit", "PurchaseOrder", new { POId = item.PurchaseOrderID })" data-po="@item.PurchaseOrderID" target="_blank" class="green_link">@item.PONumber</a>
                    }                   
                    Missing :
                    @foreach (var missingItem in item.Items.Split(',', StringSplitOptions.RemoveEmptyEntries))
                    {
                        <span class="label label-danger">@missingItem.Trim()</span>
                    }
                </div>
            }
        }
        else
        {
            <span>Nothing to show.</span>
        }
    }
    if (Model.DashboardActionName == "buildIncompleteProjectNew")
    {
        if (Model.incompleteProjectDTO.Count > 0)
        {
            var firstItem = Model.incompleteProjectDTO.First();
            var ItemCount = Model.incompleteProjectDTO.Count;
            var SelectedProjectId = firstItem.ProjectId ?? 0;

            <input type="hidden" id=@($"INCINFOP_{SelectedProjectId}_Count") data-itemcount="@ItemCount" />
            foreach (var item in Model.incompleteProjectDTO)
            {
                <div class="accspan">
                    Missing :
                    @foreach (var missingItem in item.Items.Split(',', StringSplitOptions.RemoveEmptyEntries))
                    {
                        <span class="label label-danger">@missingItem.Trim()</span>
                        <a href="@Url.Action("EditProject", "Project", new { ProjectId = item.ProjectId })" target="_blank"><i class="fas fa-edit"></i></a>
                    }
                </div>
            }
        }
        else
        {
            <span>Nothing to show.</span>
        }
    }
    if (Model.DashboardActionName == "buildIncompleteVendorNew")
    {
        if (Model.imcompleteVendorDTO.Count > 0)
        {
            var firstItem = Model.imcompleteVendorDTO.First();
            var ItemCount = Model.imcompleteVendorDTO.Count;
            var SelectedProjectId = firstItem.ProjectID ?? 0;

            <input type="hidden" id=@($"INCINFOV_{SelectedProjectId}_Count") data-itemcount="@ItemCount" />
            foreach (var item in Model.imcompleteVendorDTO)
            {
                <div class="accspan">
                    Contact :
                    <a href="@Url.Action("EditVendorContact", "Vendors", new { vendorId = item.VendorId })" target="_blank">@item.VContactName</a>
                    Missing :
                    @foreach (var missingItem in item.Items.Split(',', StringSplitOptions.RemoveEmptyEntries))
                    {
                        <span class="label label-danger">@missingItem.Trim()</span>
                    }
                </div>
            }
        }
        else
        {
            <span>Nothing to show.</span>
        }
    }
    if (Model.DashboardActionName == "buildBudgetApprovalsNew")
    {
        if (Model.incompleteBudgetDTO.Count > 0)
        {
            var firstItem = Model.incompleteBudgetDTO.First();
            var ItemCount = Model.incompleteBudgetDTO.Count;
            var SelectedProjectId = firstItem.ProjectId ?? 0;

            <input type="hidden" id=@($"BDGTAPPR_{SelectedProjectId}_Count") data-itemcount="@ItemCount" />
            <div class="table-responsive task_list_table">
                <table class="table">
                    <thead>
                        <tr>
                            <td>Action</td>
                            <td>Budget Group</td>
                            <td>Status</td>
                            <td>Comment</td>
                            <td>On Behalf of</td>
                            <td></td>
                            <td> </td>
                        </tr>
                    </thead>

                    <tbody>
                    @{
                        bool hasPending = Model.incompleteBudgetDTO.Any(x =>!x.HistoryList!.Any(h => h.Rejected == 1 && h.resend == 0)&& x.Bissent == 1);
                    }
                        @foreach (var item in Model.incompleteBudgetDTO)
                        {
                            var latestHistory = item.HistoryList.OrderByDescending(x => x.FldID).FirstOrDefault();

                            bool isRejected = latestHistory != null && latestHistory.Rejected == 1 && latestHistory.resend == 0;                 
                            if (isRejected && hasPending)
                            {
                                continue;
                            }
                            string ITEMNEW = "0" ?? string.Empty;
                            if (item.CheckingDate == "")
                            {
                                ITEMNEW = "1";
                            }
                            if (item.CheckingDate != "" && item.DateofInsert != "" && (DateTime.Parse(item.CheckingDate) < DateTime.Parse(item.DateofInsert)))
                            {
                                ITEMNEW = "1";
                            }

                            <tr>
                                                                
                                @if (item.Bissent == 1)
                                {
                                    <td>
                                    <div class="action_icons">
                                        <a style="cursor:pointer;"><i title="View Budget" class="fa fa-file-pdf-o viewBudgetReport" data-projectid="@item.ProjectId" data-sectionids="@item.sectionID"></i></a>

                                        @if (item.HistoryList!.Any())
                                        {
                                            <i title="Approval History" class="fa fa-info-circle openBudgetApprovalhistory" data-bs-toggle="modal"
                                               data-bs-target="#approval_history_new" style="cursor:pointer;" data-projectid="@item.ProjectId" data-groupid="@item.GroupID" data-sectionids="@item.sectionID"></i>
                                        }

                                    </div>
                                    </td>
                                    <td><a href="javascript:void(0);" class="openbudgetgroup" data-itemid="@item.GroupID">@item.groupname</a></td>
                                    if (item.AlreadyApproved < item.NumOfUserToAprv_Budget)
                                    {
                                        <td>@item.AlreadyApproved/@item.NumOfUserToAprv_Budget</td>
                                        <td><input type="text" class="form-control"></td>
                                        <td>
                                            @if (item.Budget_Is_Manager == "1")
                                            {
                                                <select class="form-select" style="max-width: 300px;" id='@("userddl_budget_" + item.ProjectId + "_" + item.GroupID)'>
                                                    <option value="0">--Select--</option>
                                                    @foreach (var user in item.BudgetUserList)
                                                    {
                                                        <option value="@user.Id">@user.Name</option>
                                                    }
                                                </select>
                                                <input type="hidden" value="1" id='@("ismanager_budget_" + item.ProjectId + "_" + item.GroupID)' />
                                            }
                                            else
                                            {
                                                <input type="hidden" value="0" id='@("ismanager_budget_" + item.ProjectId + "_" + item.GroupID)' />
                                            }
                                        </td>
                                        <td>
                                            <input type="button" value="Approve" data-groupid="@item.GroupID" data-projectid="@item.ProjectId" class="gray_checkbtn approveBudget">
                                            <input type="button" value="Reject" data-groupid="@item.GroupID" data-projectid="@item.ProjectId" class="gray_checkbtn rejectBudget">
                                        </td>
                                    }
                                    else
                                    {
                                        <td>Approved</td>
                                        <td><input type="text" disabled class="form-control"></td>
                                        <td>
                                            @if (item.Budget_Is_Manager == "1")
                                            {
                                                <select class="form-select" style="max-width: 300px;" id='@("userddl_budget_" + item.ProjectId + "_" + item.GroupID)' disabled>
                                                </select>
                                                <input type="hidden" value="1" id='@("ismanager_budget_" + item.ProjectId + "_" + item.GroupID)' />
                                            }
                                        </td>
                                        <td>
                                        </td>
                                    }
                                }                                
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <span>Nothing to show.</span>
        }

    }
    if (Model.DashboardActionName == "buildPOApprovalsNew")
    {
        if (Model.incompleteTaskPoDTO.Count > 0)
        {
            var projectfirstItem = Model.incompleteTaskPoDTO.First();
            var SelectedProjectId = projectfirstItem.projectid ?? 0;
            var ItemCount = Model.incompleteTaskPoDTO.Count;
            var parentVendorGroup = Model.incompleteTaskPoDTO.GroupBy(p => p.vendor_id).ToList();

            <input type="hidden" id=@($"POAPPR_{SelectedProjectId}_Count") data-itemcount="@ItemCount" />
            <div class="accordion taskList" id="">
                @foreach (var group in parentVendorGroup)
                {
                    var firstItem = group.First();
                    var vendorId = firstItem.vendor_id;
                    var projectid = firstItem.projectid;
                    var Vcount = group.Count();
                    var uniqueId = "POAPPR_Indv_" + firstItem.vendor_id;
                    int NEW = string.IsNullOrEmpty(firstItem.CheckingDate) ||
                    (!string.IsNullOrEmpty(firstItem.LatestDate) &&
                    Convert.ToDateTime(firstItem.CheckingDate) < Convert.ToDateTime(firstItem.LatestDate))
                    ? 1 : 1;

                    <div class="accordion-item">
                        <div class="accordion-button collapsed ChangViewStatus" role="button" data-bs-toggle="collapse"
                                data-bs-target="#@uniqueId" aria-expanded="false" data-id="@vendorId" data-projectid="@projectid" data-vcount="@Vcount" data-mode="POAPPR">
                            <div class="task_name">@firstItem.parentvendorname</div>
                            <div class="task_cont"><span>Contact :</span><a href="@Url.Action("EditVendorContact", "Vendors", new { vendorId = firstItem.vendor_id })">@firstItem.ContactName</a></div>
                            <div class="task_phone">Phone : <span>@firstItem.phone</span></div>
                            <div class="task_email">
                                <span>Email :</span><a href="#">@firstItem.email</a>
                            </div>
                            <div class="task_badge">
                                <span class="badge">@Vcount</span>
                                @if (NEW == 1)
                                {
                                    <span class="badge">NEW</span>
                                }
                            </div>

                        </div>

                        <div id="@uniqueId" class="accordion-collapse collapse">
                            <div class="accordion-body">
                                <div class="table-responsive task_list_table">
                                    <table class="table">
                                        <thead>
                                            <tr>
                                                <td>Action</td>
                                                <td>PO #</td>
                                                <td>Remarks</td>
                                                <td class="text-end">Pre-tax Amount</td>
                                                <td>Status</td>
                                                <td>Sending Date</td>
                                                <td>File</td>
                                                <td>Comment</td>
                                                <td>On Behalf Of</td>
                                                <td>Approve</td>
                                                <td>Reject</td>
                                                @*<td>Comment</td>*@

                                            </tr>
                                        </thead>

                                        <tbody>
                                            @foreach (var po in group)
                                            {
                                                var lhtml = string.IsNullOrEmpty(po.LevelStatus)
                                                ? "(Level 0/1)"
                                                : $"(Level {po.LevelStatus.Split('^')[1]}/{po.LevelStatus.Split('^')[0]})";

                                                var T1 = "";

                                                @if (po.OverCommitedList.Count > 0)
                                                {
                                                    foreach (var item2 in po.OverCommitedList)
                                                    {
                                                        var PO = (item2.CommitedCost * item2.Rate);
                                                        T1 += $"Section:-{item2.Sectionnumber}-{item2.NAME} \r\nItem:-{item2.ItemNumber} {item2.Description} \r\nPO cost/Budget Cost:- {PO.Value.ToString("#,##0")}/{item2.BudgetAmount.Value.ToString("#,##0")} {item2.Currency} \r\n";
                                                    }
                                                }

                                                <tr>
                                                    <td>
                                                        @if (UserRoleId == 3 || UserRoleId == 2 || UserRoleId == 1)
                                                        {
                                                            <a data-poid="@po.purchaseorderid" class="ProffPO" style="color:#000000"><i title="View PO" class="fa fa-file-pdf-o" style="cursor:pointer;"></i></a>
                                                            <i title="PO Download" class="fa fa-download download_btn" data-poid="@po.purchaseorderid" data-showid="@po.POID" style="cursor:pointer;"></i>
                                                            <i title="PO History" class="fa fa-info-circle pohistoryredirect" data-poid="@po.purchaseorderid" style="cursor:pointer;"></i>
                                                            <a class="openpohistory" data-levelstatus="@po.LevelStatus" data-poid="@po.purchaseorderid" data-bs-toggle="modal" data-bs-target="#po_Approval_history" style="color:#000000"><i title="PO Approval History" class="fa fa-history" style="cursor:pointer;"></i></a>
                                                            if (po.OverCommitedList.Count > 0)
                                                            {
                                                                <a style="cursor:pointer;color: #e85b5b;" class="openOverCommited" data-projectid="@po.projectid" data-poid="@po.purchaseorderid" data-bs-toggle="modal" data-bs-target="#po_over_commited_history"><i title="@Html.Raw(T1)" class="fa fa-exclamation-circle"></i></a>
                                                            }
                                                        }
                                                        else
                                                        {
                                                            <a data-poid="@po.purchaseorderid" class="ProffPO" style="color:#000000"><i title="View PO" class="fa fa-file-pdf-o" style="cursor:pointer;"></i></a>
                                                            <i title="PO Download" class="fa fa-download download_btn" data-poid="@po.purchaseorderid" data-showid="@po.POID" style="cursor:pointer;"></i>
                                                            <i title="PO History" class="fa fa-info-circle pohistoryredirect" data-poid="@po.purchaseorderid" style="cursor:pointer;"></i>
                                                            <a class="openpohistory" style="color:#000000" data-levelstatus="@po.LevelStatus" data-poid="@po.purchaseorderid" data-bs-toggle="modal" data-bs-target="#po_Approval_history"><i title="PO Approval History" class="fa fa-history" style="cursor:pointer;"></i></a>
                                                            if (po.OverCommitedList.Count > 0)
                                                            {
                                                                <a style="cursor:pointer;color: #e85b5b;" class="openOverCommited" data-projectid="@po.projectid" data-poid="@po.purchaseorderid" data-bs-toggle="modal" data-bs-target="#po_over_commited_history"><i title="@Html.Raw(T1)" class="fa fa-exclamation-circle"></i></a>
                                                            }
                                                        }

                                                    </td>
                                                    <td>
                                                        @*@if (po.clientorvendorCount == 0)
                                                        {
                                                            <a href="@Url.Action("POEdit", "PurchaseOrder", new { POId = po.purchaseorderid })" data-po="@po.purchaseorderid" target="_blank" class="green_link">@po.POID</a>
                                                        }
                                                        else
                                                        {
                                                            <a style="cursor:pointer;" data-poid="@po.purchaseorderid" class="green_link ProffPO">@po.POID</a>
                                                        }*@

                                                        @if (IsPoEditAccessPermission == "0")
                                                        {
                                                            <a style="cursor:pointer;" href="javascript:void(0)" data-poid="@po.purchaseorderid" class="green_link ProffPO">
                                                                @po.POID
                                                            </a>                                                           
                                                        }
                                                        else
                                                        {
                                                            <a href="@Url.Action("POEdit", "PurchaseOrder", new { POId = po.purchaseorderid })" data-po="@po.purchaseorderid" target="_blank" class="green_link">@po.POID</a>
                                                        }              

                                                    </td>
                                                    <td>@po.remarks</td>
                                                    <td class="text-end">@(po.PTA.HasValue? po.PTA.Value.ToString("#,##0") : "0")(@po.Currency)</td>
                                                    <td>@po.LevelApprovalStatus.Split("^")[0]/@po.LevelApprovalStatus.Split("^")[1] @lhtml</td>
                                                    <td>@po.ArrivedDate</td>
                                                    <td><input type="file" name="" class="form-control" multiple></td>
                                                    <td>
                                                        <input data-id="@po.purchaseorderid" style="width:100%;" type="text" class="form-control poapproverejectchk2">
                                                    </td>
                                                    <td>
                                                        @if (po.onbehalfof.Any())
                                                        {
                                                            var Count = 0;
                                                            <select class="form-select" data-id="@po.purchaseorderid" id="userddl_@po.purchaseorderid">
                                                                @foreach (var userList in po.onbehalfof)
                                                                {

                                                                    if (UserName.ToUpper() == userList.Name.ToUpper())
                                                                    {
                                                                        Count++;
                                                                        <option value="@UserId" selected>@UserName</option>
                                                                    }
                                                                }
                                                                @if (Count == 0)
                                                                {
                                                                    <option value="0" selected>---Select---</option>
                                                                }
                                                                @foreach (var userList in po.onbehalfof)
                                                                {
                                                                    if (Count == 0 && (UserRoleId != 4 || UserRoleId != 5))
                                                                    {
                                                                        <option value="@userList.Id">@userList.Name</option>
                                                                    }
                                                                }
                                                            </select>
                                                            <input type="hidden" value="1" id="ismanager_@po.purchaseorderid" />
                                                        }
                                                        else
                                                        {
                                                            <input type="hidden" value="0" id="ismanager_@po.purchaseorderid" />
                                                        }
                                                    </td>
                                                    <td class="text-center">
                                                        <input type="checkbox" data-id="@po.purchaseorderid" class="poapproverejectchk approve" id="poapprove_@po.purchaseorderid">
                                                    </td>
                                                    <td class="text-center">
                                                        <input type="checkbox" data-id="@po.purchaseorderid" class="poapproverejectchk reject" id="poreject_@po.purchaseorderid">
                                                    </td>

                                                    @* Block Because Client Said to remove Comment Check box 19-11-2025 *@
                                                    @*<td class="text-center">
                                                        <input type="checkbox" data-id="@po.purchaseorderid" class="poapproverejectchk comment" id="pocomment_@po.purchaseorderid">
                                                    </td>*@
                                                </tr>
                                            }

                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                }

            </div>
        }
        else
        {
            <span>Nothing to show.</span>
        }

    }
    if (Model.DashboardActionName == "buildFabApprovalsNew")
    {
        if (Model.incompleteFabDTO.Count > 0)
        {
            var projectfirstItem = Model.incompleteFabDTO.First();
            var ItemCount = Model.incompleteFabDTO.Count;
            var SelectedProjectId = projectfirstItem.Project_ID ?? 0;
            var parentVendorGroup = Model.incompleteFabDTO.GroupBy(p => p.Vendor_ID).ToList();

            <input type="hidden" id=@($"POITEMAPPR_{SelectedProjectId}_Count") data-itemcount="@ItemCount" />

            <div class="accordion taskList" id="">
                @foreach (var group in parentVendorGroup)
                {
                    var firstItem = group.First();
                    var vendorId = firstItem.Vendor_ID;
                    var projectid = firstItem.Project_ID;
                    var Vcount = group.Count();
                    var uniqueId = "POITEMAPPR_Indv_" + firstItem.Vendor_ID;

                    var IsManager = firstItem.IsManager;
                    var hideOnBehalfOf = (UserRoleId == 3 || UserRoleId == 2) ? "" : "display:none;";
                    var disableFabpath = (UserRoleId == 3 || UserRoleId == 3 || IsManager == "1") ? "" : "disabled";

                    <div class="accordion-item">
                        <div class="accordion-button collapsed ChangViewStatus" role="button" data-bs-toggle="collapse"
                                data-bs-target="#@uniqueId" aria-expanded="false" data-id="@vendorId" data-projectid="@projectid" data-vcount="@Vcount" data-mode="POITEMAPPR">
                            <div class="task_name">@firstItem.ParentVendorName</div>
                            <div class="task_cont"><span>Contact :</span><a href="@Url.Action("EditVendorContact", "Vendors", new { vendorId = firstItem.Vendor_ID })">@firstItem.ContactName</a></div>
                            <div class="task_phone">Phone : <span>@firstItem.Phone</span></div>
                            <div class="task_email">
                                <span>Email :</span><a href="#">@firstItem.Email</a>
                            </div>
                            <div class="task_badge"><span class="badge">@Vcount</span></div>
                        </div>

                        <div id="@uniqueId" class="accordion-collapse collapse">
                            <div class="accordion-body">
                                <div class="table-responsive task_list_table">
                                    <table class="table">
                                        <thead>
                                            <tr>
                                                <td>Action</td>
                                                <td>Type</td>
                                                <td>Status</td>
                                                <td>Approval Description</td>
                                                <td>PO #</td>
                                                <td>Item Description</td>
                                                <td>Spec</td>
                                                <td style="@hideOnBehalfOf">On behalf of</td>
                                                <td>Comment</td>
                                                <td>Attachments</td>
                                                <td>Approval path</td>
                                                <td></td>
                                            </tr>
                                        </thead>

                                        <tbody>
                                            @foreach (var fab in group)
                                            {
                                                var id = fab.ItemApprovalID;
                                                var approvedby = fab.TotalNumberOfApproval;
                                                var requiredby = fab.NumberToApprovPO;
                                                var alreadyapproved = fab.TotalNumberOfLevelApproval;
                                                var TotallevelApprover = fab.NumberToApprovedLevel;
                                                var latestStatus = string.IsNullOrEmpty(fab.LatestStatus) || fab.LatestStatus == "Added" ? "Required" : fab.LatestStatus;
                                                int ItemNew = string.IsNullOrEmpty(fab.CheckingDate)
                                                || (!string.IsNullOrEmpty(fab.InserttDate)
                                                && DateTime.TryParse(fab.CheckingDate, out var checkDate)
                                                && DateTime.TryParse(fab.InserttDate, out var insertDate)
                                                && checkDate < insertDate)
                                                ? 1 : 0;

                                                // Determine lhtm status
                                                var lhtm = (approvedby == "0" && requiredby == "0" && latestStatus == "Approved") ?
                                                "(All Approved)" :
                                                (latestStatus == "Required" && !string.IsNullOrEmpty(TotallevelApprover)) ?
                                                $" (0/1) ({latestStatus})" :
                                                $" ({approvedby}/{requiredby}) ({latestStatus})";

                                                // Determine lhtm1 status
                                                var lhtm1 = (string.IsNullOrEmpty(TotallevelApprover) && (latestStatus == "Required" || latestStatus == "Rejected")) ?
                                                $" (Level 0/{alreadyapproved})" :
                                                (latestStatus == "Approved" && string.IsNullOrEmpty(TotallevelApprover)) ?
                                                $" (Level {alreadyapproved}/{alreadyapproved})" :
                                                $" (Level {TotallevelApprover}/{alreadyapproved})";

                                                <tr>
                                                    <td>
                                                        <select class="form-select ddl_actiontype_change" id="ddl_actiontype_@id" data-polineiteam="@id" data-projectid="@fab.Project_ID">
                                                            <option value="0" selected>---Select</option>
                                                            @foreach (var allowdAction in fab.AllowdAction)
                                                            {
                                                                <option value="@allowdAction.fldid">@allowdAction.actiontype</option>
                                                            }
                                                        </select>
                                                        <input style="display:none;" autocomplete="off" type="text" name="name" value="" class="form-control fabdate mt-2" placeholder="YYYY.MM.DD" id="datepicker_@id" />
                                                    </td>
                                                    <td>@fab.ItemName</td>
                                                    <td>@lhtm@lhtm1</td>
                                                    <td>@fab.Description</td>
                                                    <td>
                                                        @if (IsPoEditAccessPermission == "0")
                                                        {
                                                            <a style="cursor:pointer;" href="javascript:void(0)" data-poid="@fab.PurchaseOrderID" class="green_link ProffPO">
                                                                @fab.TotalPOID
                                                            </a>                                                           
                                                        }
                                                        else
                                                        {
                                                            <a href="@Url.Action("POEdit", "PurchaseOrder", new { POId = fab.PurchaseOrderID })" data-po="@fab.PurchaseOrderID" target="_blank" class="green_link">@fab.TotalPOID</a>
                                                        }                                                  
                                                    </td>
                                                    <td>@fab.Remarks</td>
                                                    <td>@fab.SpecNum</td>
                                                    <td style="@hideOnBehalfOf">
                                                        @if (IsManager == "1")
                                                        {
                                                            <select class="form-select selectuser" id="ddl_selectuser_@id">
                                                                <option value="0">---Select User---</option>
                                                            </select>
                                                        }
                                                    </td>
                                                    <td>
                                                        <input type="text" class="form-control" id="textarea_@id" autocomplete="off">
                                                    </td>
                                                    <td>
                                                        <input type="file" multiple name="" id="file_@id">
                                                    </td>
                                                    <td>
                                                        <select class="form-select ddl_approvalpath_change" id="ddl_grpname_@id" data-id="@id" data-item="@fab.POLineItemID" data-projectid="@fab.Project_ID" @disableFabpath>
                                                            <!option value="0">---Select Action---</!option>
                                                            @foreach (var FabPath in fab.FabPathList)
                                                            {
                                                                <!option value="@FabPath.Id" selected="@(fab.FabPathId.ToString() == FabPath.Id.ToString() ? "selected" : null)">@FabPath.Name</!option>
                                                            }
                                                        </select>
                                                    </td>
                                                    <td class="adj_width">
