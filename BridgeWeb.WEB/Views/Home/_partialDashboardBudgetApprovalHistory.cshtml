@model BridgeWeb.Domain.Model.MultipleModel

@if (Model.budgetApprovalHstAndStatus.budgetSendApprovalStatusDTOs.Count > 0)
{
    var SentForApprovalDate = "";
    int? NumOfUserToAprv_Budget = 0;
    int? AlreadyApprovedvr = 0;
    var DateWhenBudgetApproved = "";
    var alreadyapproved = "";
    var alreadyapproved1 = "";
    var toapprove = "";
    var toapprove1 = "";
    var textstatusforapproval = "";
    @foreach (var item in Model.budgetApprovalHstAndStatus.budgetSendApprovalStatusDTOs)
    {
        var ManagerName = item.ManagerName;
        var UserName = item.UserName;
        var Approved = item.Approved;
        SentForApprovalDate = item.SentForApprovalDate;
        NumOfUserToAprv_Budget = item.NumOfUserToAprv_Budget;
        DateWhenBudgetApproved = item.DateWhenBudgetApproved;
        AlreadyApprovedvr = item.AlreadyApproved;
        var UserApprovedDate = item.UserApprovedDate;
        var titleinner = "";

        if (Approved == 1)
        {
            if (!string.IsNullOrEmpty(ManagerName))
            {
                titleinner = "By " + ManagerName + ". ";
            }
            else
            {
                titleinner = "Self Approved ";
            }

            titleinner += "On " + UserApprovedDate;
            if (string.IsNullOrEmpty(alreadyapproved1))
            {
                alreadyapproved1 += $"<span style=\"cursor:pointer;\" title=\"{titleinner}\"><i class=\"fa fa-check\" style=\"color: #449d44;\"></i> {UserName}</span>";
            }
            else
            {
                alreadyapproved1 += $", <span style=\"cursor:pointer;\" title=\"{titleinner}\"><i title=\"{titleinner}\" class=\"fa fa-check\" style=\"color: #449d44;\"></i> {UserName}</span>";
            }

            if (string.IsNullOrEmpty(alreadyapproved))
            {
                alreadyapproved += UserName;
            }
            else
            {
                alreadyapproved += ", " + UserName;
            }
        }
        else
        {
            if (string.IsNullOrEmpty(toapprove1))
            {
                toapprove1 += $"<i class=\"fa fa-times mrg5R\" style=\"color: #E33747;\"></i> {UserName}";
            }
            else
            {
                toapprove1 += $", <i class=\"fa fa-times mrg5R\" style=\"color: #E33747;\"></i> {UserName}";
            }

            if (string.IsNullOrEmpty(toapprove))
            {
                toapprove += UserName;
            }
            else
            {
                toapprove += ", " + UserName;
            }
        }
    }

    if (NumOfUserToAprv_Budget > AlreadyApprovedvr)
    {
        textstatusforapproval = ". Budget is not yet approved.";
    }
    else
    {
        textstatusforapproval = ". Budget was approved on " + DateWhenBudgetApproved + ".";
        toapprove1 = "";
    }
    if (alreadyapproved1.Trim() != "" && (NumOfUserToAprv_Budget > AlreadyApprovedvr))
    {
        alreadyapproved1 += " | ";
    }
    <div class="col"><p>Sent for approval on @SentForApprovalDate @textstatusforapproval </p></div>
    <div class="col"><strong> @Html.Raw(alreadyapproved1) @Html.Raw(toapprove1)</strong></div>

}

