</ul> *@



<table id="prevversionapproval" class="table">
    <thead style="background:rgba(60, 74, 85, 0.35); text-align:center;">
        <tr>

            <th style="text-align: center; width:50%;">History</th>
            <th style="text-align: center; width:50%;">Comment</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.budgetApprovalHstAndStatus.budgetApprovalHstDTOs.Any())
        {
            @foreach (var item in Model.budgetApprovalHstAndStatus.budgetApprovalHstDTOs)
            {
                var cdate = "";
                if (item.Version == 1)
                {
                    cdate = $", Added on {item.CreatedDate}";
                }
                else
                {
                    cdate = $", Budget revised on {item.CreatedDate}";
                }
                <tr style="background: rgb(192, 186, 186);">
                    <td> (@item.Version VERSION) VERSION NAME : @item.Versionname @cdate, FROM @item.GroupName GROUP</td>
                    <td>
                        <ul>
                            @if ((string.IsNullOrEmpty(item.ApprovedByName) || string.IsNullOrWhiteSpace(item.ApprovedByName)) && item.Comment != "")
                            {
                                <li>@item.Approver @item.Status on @item.CreatedDate with @item.Comment</li>
                            }
                            else if ((string.IsNullOrEmpty(item.ApprovedByName) || (string.IsNullOrWhiteSpace(item.ApprovedByName)) && item.Comment == ""))
                            {
                                <li>@item.Approver @item.Status on @item.CreatedDate</li>
                            }
                            else
                            {
                                <li>@item.ApprovedByName @item.Status on behalf of @item.Approver on @item.CreatedDate </li>
                            }
                        </ul>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr style="background: rgb(192, 186, 186);">
                <td colspan="2" class="text-center">
                    Budget not yet submitted for approval
                </td>
            </tr>
        }
    </tbody>
</table>
