        <input type="number" class="otp_inp">
        <input type="number" class="otp_inp">
      </form>
      <p class="resend">Didn't receive the OTP? <a href="javascript:void(0);" class="disabled" id="resendbtn">Resend</a></p>
      <div class="btn_wrp">
        <button type="button" class="submit_btn" id="verifyotp">Submit</button>
        <button type="button" class="border_btn" id="cancelbtn">Cancel</button>
      </div>
      <p class="otp-timer" id="otptimer">OTP will expire in <b id="countdown">30:00</b></p>
      <p class="otp-expire-msg d-none" id="otpexpired">OTP Expired</p>
    </div>



