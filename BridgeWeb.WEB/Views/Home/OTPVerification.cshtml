    <div class="otp_wrap">
      <div class="otp_heading">
        <h3>Verify with OTP</h3>
        <p>To ensure your security,please enter One-Time Password (OTP) sent to your registered email id</p>
      </div>

      <form action="#" class="otp_form">
        <input type="number" class="otp_inp">
