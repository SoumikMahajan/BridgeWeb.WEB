@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "TheBridgeByTCG";
}


<h3 class="text-danger d-flex justify-content-center align-items-center">Please Reset Your Password</h3>
<form id="resetPasswordForm" class="reset_form">
    @Html.AntiForgeryToken()
    <div class="pasword frm_fld">
        <label>Password</label>
        <input type="password" id="Password" name="Password">
        <div id="passwordRequirements" class="d-none">
            <ul>
                <li id="reqLength">✔ 8–15 characters</li>
                <li id="reqUpper">✔ At least one uppercase</li>
                <li id="reqLower">✔ At least one lowercase</li>
                <li id="reqDigit">✔ At least one digit</li>
                <li id="reqSpecial">✔ At least one special character</li>
            </ul>
        </div>
    </div>
    <div class="password frm_fld">
        <label>Confirm Password</label>
        <input type="Password" id="ConfirmPassword" name="ConfirmPassword">
        <div id="confirmPasswordMsg" class="d-none">
            <span id="matchMsg">Passwords do not match</span>
        </div>
    </div>    
    <div class="forget_btns">
        <input type="button" value="Reset Password" class="input_btn" id="btnReset">
    </div>
</form>