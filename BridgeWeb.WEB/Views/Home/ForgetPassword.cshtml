@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "TheBridgeByTCG";
    var Token = Guid.NewGuid().ToString();
}

<form id="forgetPasswordForm" action="#" class="forget_pass_form">
    @Html.AntiForgeryToken()
    <div class="email frm_fld">
        <label>E-mail ID</label>
        <input type="email" name="email" id="email">
        <a href="@Url.Content("~/Home/Index")" class="cancle_btn">Log In</a>
    </div>
    <div class="forget_btns">
        <input type="button" value="Reset Password" class="input_btn" id="forgetPasswordBtn">
    </div>
</form>