@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=0" name="viewport" />
    <meta name="author" content="" />
    <title>UnaothorizedAccess</title>

    <!--fav icon-->
    <link rel="shortcut icon" href="@Url.Content("~/images/favicon-tcg.ico")" type="image/x-icon" />
    <!-- Default links -->
    <link href="@Url.Content("~/css/bootstrap.min.css")" rel="stylesheet" type="text/css" />
    <!--Alegreya font -->
    <link href='https://fonts.googleapis.com/css?family=Alegreya+Sans:400,300,500,700' rel='stylesheet' type='text/css'>
    <!-- Open Sans font -->
    <link href="https://fonts.googleapis.com/css2?family=Open+Sans:ital,wght@0,300..800;1,300..800&display=swap"
          rel="stylesheet">

    <!-- fontAwesome -->
    <link rel="stylesheet" href="@Url.Content("~/css/fontawsome6.min.css")">
    <!-- custom links -->
    <link href="@Url.Content("~/css/custom.css")" asp-append-version="true" rel="stylesheet" type="text/css" />
    <link href="@Url.Content("~/css/responsive.css")" asp-append-version="true" rel="stylesheet" type="text/css" />
    <link href="@Url.Content("~/css/developer.css")" asp-append-version="true" rel="stylesheet" type="text/css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/izitoast/1.4.0/css/iziToast.min.css" />
</head>

<body>   
    <div>
      Unauthorized Access Error : Redirecting to <a style="text-decoration:underline;" href="~/Home/Dashboard"> DashBoard </a>
        in <label id="countdowntimer">5</label> seconds...
    </div>

    <!-- scrips -->
    <script src="@Url.Content("~/js/jquery.min.js")"></script>
    <script src="@Url.Content("~/js/bootstrap.bundle.min.js")"></script>
    <script src="@Url.Content("~/js/fontawsome6.min.js")"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/izitoast/1.4.0/js/iziToast.min.js"></script>     
    
    <script type="text/javascript">
        $(document).ready(function () {
            const options = {
                title: 'Error',
                position: 'topRight',
                message: 'Unauthorized Access Error',
            };
            iziToast.error(options);

            var i = 5;
            window.setInterval(function () {
                $('#countdowntimer').text(i--);
            }, 1000);

            window.setTimeout(function () {              
                window.location.href = '/Home/Dashboard';
            }, 5000);
        });
    </script>
</body>
</html>