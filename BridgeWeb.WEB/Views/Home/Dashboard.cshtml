@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@{
    var userRoleId = ViewData["UserRoleId"] ?? "0";
    var userName = ViewData["UserName"] ?? "";
}

<!-- breadcrumb -->
<div class="bread_cumb_wrp">
    <div class="container-fluid">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="#">Home</a></li>
                <li class="breadcrumb-item active" aria-current="page"><span>TASK LIST</span></li>
            </ol>
        </nav>
    </div>
</div>


<!-- breadcrumb -->
<!-- Expledite section -->
<section class="master_wrap home_wrp">
    <div class="container-fluid">
        @* <button class="solid_teal_btn" onclick="openTaskManager()"><i class="fa fa-tasks mr-5"></i>Assign Task</button> *@
        <h2 class="section_header">
            @userName'S TASK LIST <i class="fa fa-refresh" title="Refresh Task List" id="refreshtask"></i>
        </h2>
        <div id="mytasklist">
            @* Partial page _partialDashBoardProjectsList *@
        </div>
    </div>
</section>
<!-- Expledite section-->

<input type="hidden" id="hdn_usertype" value="@userRoleId" />


<!--Budget History Modal POPup-->
<div class="modal fade" id="approval_history_new" tabindex="-1" aria-labelledby="exampleModalLabel"
     aria-hidden="true">
