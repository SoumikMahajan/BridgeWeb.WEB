        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title">Approval History</h1>
                <button type="button" class="modal-close" data-bs-dismiss="modal" aria-label="Close">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>
            <div class="modal-body approval_data approval_history" style="height:450px; overflow-y:auto;">
                <div id="partailBudgetApprovalHistory">
                    
                </div>
               
                
            </div>
            <div class="modal-footer">
                <button type="button" data-bs-dismiss="modal" class="offwhite_btn">Close</button>
            </div>
        </div>
    </div>
</div>
