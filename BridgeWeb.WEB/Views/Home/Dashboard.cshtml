<!--Send mail to vendor Modal-->
<div class="modal fade send_mail_modal" id="send_mail_modal" tabindex="-1" aria-labelledby="exampleModalLabel"
     aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title">Send Mail</h1>
                <button type="button" class="modal-close" data-bs-dismiss="modal" aria-label="Close">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>

            <div class="modal-body">
                <div class="mail_top">
                    <div class="row">
                        <div class="col-lg-3">
                            <label>To:</label>
                        </div>
                        <div class="col-lg-9">
                            <input type="text" class="form-control" id="vendormailto" placeholder="vendor@vendor.com" data-email="" data-contactid="">
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-lg-3">
                            <label>Subject:</label>
                        </div>
                        <div class="col-lg-9">
                            <input type="text" class="form-control" id="subject">
                        </div>
                    </div>
                    @* <div class="row">
                        <div class="col-lg-3">
                            <label>Add Dynamic field :</label>
                        </div>
                        <div class="col-lg-9">
                            <select name="" id="mailDynamicField" class="form-select">
                                <option value="1">Link to Home</option>
                                <option value="PROJECTNAME">Project Name</option>
                                <option value="PROJECTNUMBER">Project Number</option>
                                <option value="PONUMBER">PO Number</option>
                                <option value="VENDORNAME">Vendor Name</option>
                                <option value="CONTACTNAME">Contact Name</option>
                                <option value="USERNAME">User Name</option>
                                <option value="USERADDRESS">User Address</option>
                            </select>
                        </div>
                    </div> *@
                </div>
                <textarea id="editor" class="ckeditor"></textarea>
            </div>

            <div class="modal-footer">
                <div class="cc_mail_btn">
                    <label>Add self to CC <input type="checkbox" id="selfCC" checked></label>
                </div>
                <button type="button" class="offwhite_btn" id="mailsendvendorbtn" data-poid="" data-projectid="">Send Mail</button>
            </div>
        </div>
    </div>
</div>
<!---->

<!--Send PDF to vendor Modal-->
<div class="modal fade send_mail_modal" id="sendmailtovendor_new" tabindex="-1" aria-labelledby="exampleModalLabel"
     aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title">Send Mail</h1>
                <button type="button" class="modal-close" data-bs-dismiss="modal" aria-label="Close">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>

            <div class="modal-body">
                <div class="mail_top">
                    <div class="row">
                        <div class="col-lg-3">
                            <label>To:</label>
                        </div>
                        <div class="col-lg-9">
                            <input type="text" class="form-control" id="vendormailto_new" placeholder="vendor@vendor.com" data-email="" data-vid="">
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-lg-3">
                            <label>Subject:</label>
                        </div>
                        <div class="col-lg-9">
                            <input type="text" class="form-control" id="vendormailsubject_new" value="Approved Purchase Order Reminder">
                        </div>
                    </div>                    
                </div>
                <textarea id="vendormailbody_new" class="ckeditor"></textarea>
            </div>

            <div class="modal-footer">
                <div class="cc_mail_btn">
                    <label>Add self to CC <input type="checkbox" id="sendaddcc_new" checked></label>
                </div>
                <button type="button" class="offwhite_btn" id="mailsendvendorbtn_new" data-poid="" data-projectid="" data-vendorid="">Send Mail</button>
            </div>
        </div>
    </div>
</div>
