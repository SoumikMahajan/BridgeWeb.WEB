<!-- Modal -->
<div class="modal fade download_files" id="download_files" tabindex="-1" aria-labelledby="exampleModalLabel"
     aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title">DOWNLOAD SELECTED FILES</h1>
                <button type="button" class="modal-close" data-bs-dismiss="modal" aria-label="Close">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>

            <div class="modal-body">
                <div class="row">
                    @* <div id="detailsandfilebind"></div> *@
                    <div class="col-lg-6">
                        <h2 class="section_header"><input type="checkbox" checked id="checkuncheckallpdfs">PURCHASE ORDER PDF(S)</h2>
                        <div class="po_pdf">
                            <div class="po_pdf_list" id="poPDFDownload">
                            </div>
                        </div>
                    </div>

                    <div class="col-lg-6">
                        <h2 class="section_header"><input type="checkbox" checked id="checkuncheckallattachments">ATTACHMENTS</h2>
                        <div class="down_attact">
                            <div class="down_attact_list" id="poAttachmentDownload">
                            </div>
                        </div>
                    </div>
                    
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="gray_checkbtn" data-bs-dismiss="modal" id="unselectBtn">CANCEL AND REMOVE UNSELECTED</button>
                <button type="button" class="gray_checkbtn" id="downloadFilesBtn">DOWNLOAD SELECTED FILES</button>
            </div>
        </div>
    </div>
</div>

