                                    }
                                }                                
                            </select>
                        </div>
                        <div class="frm_fld_wrp">
                            <label for="form-label">Postal/Zip Code</label>
                            <input type="text" id="txt_ZipCode" style="text-transform:uppercase" class="form-control" value="@Model.parentVendorDto.ZipCode">
                        </div>
                    </div> *@
                </form>
            </div>

            <div class="col-xl-6" id="permissionShowHide">
                <h2 class="section_header">Permission</h2>
                <form action="#" class="row security_frm custom_gutter5-x" id="add_contact_form">
                    @Html.AntiForgeryToken()
                    <div class="col-12 check_uncheck_all">
                        <input type="button" class="gray_checkbtn" value="Uncheck All" id="uncheckall" />
                        <input type="button" class="gray_checkbtn" value="Check All" id="checkall" />
                    </div>

                    @foreach (var item in Model.systemPermissionLists)
                    {

                        var dcac = item.SystemPermission.ToUpper();
                        if (item.SystemPermission.ToUpper() != "PROJECT" && item.SystemPermission.ToUpper() != "USER" && item.SystemPermission.ToUpper() != "VENDOR")
                        {
                            int key = 0;
                            <div class="col-lg-3">
                                <div class="check_wrp">
                                    <div class="check_hdng">
                                        <h3>@item.SystemPermission</h3>
                                        <input type="checkbox" value="project" id="@item.SystemPermission" class="headerCheckbox">
                                    </div>
                                    <ul class="check_list">
                                        @foreach (var option in item.SystemPermissionOption)
                                        {
                                            <li>
                                                <label for="creat">@option.description</label>
                                                @if (option.is_selected == 1)
                                                {
                                                    <input type="checkbox" id="@item.SystemPermission@key" data-sysid="@option.fldid" class="project_check systemoption" checked>
                                                }
                                                else
                                                {
                                                    <input type="checkbox" id="@item.SystemPermission@key" data-sysid="@option.fldid" class="project_check systemoption">
                                                }

                                            </li>
                                            key++;
                                        }

                                    </ul>
                                </div>
                            </div>
                            index++;
                        }

                    }
                </form>
            </div>
        </div>
    </div>
</section>
<!-- edit project list-->
<!-- flote icon -->
<div class="flote_icon">
    <ul>
        <li>
            <a href="#" class="global-popover" data-bs-toggle="popover" data-bs-trigger="hover"
               data-bs-content="Save Contact" id="btn_CrtNewVendorContact">
                <i class="fa-regular fa-floppy-disk"></i>
            </a>
        </li>
    </ul>
</div>
