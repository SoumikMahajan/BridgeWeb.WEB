                                }
                            </select>
                        </div>
                        <div class="frm_fld_wrp">
                            <label for="form-label">State/Prov</label>
                            <select class="form-select" id="ddlState">
                                @if (Model.parentVendorDto.Country != 0)
                                {
                                    @foreach (var item in Model.StateList)
                                    {
                                        <!option value="@item.StateID" selected="@(Model.parentVendorDto.State.ToString() == @item.StateID.ToString())">@item.State</!option>

                                    }
                                }
                                else
                                {
                                    <!option value="0" selected>--Select State--</!option>
                                    @foreach (var item in Model.StateList)
                                    {
                                        <!option value="@item.StateID">@item.State (@item.StateCode)</!option>
                                    }
                                }
                            </select>
                        </div>
                    </div>

                    <div class="col-lg-6">
                        <div class="frm_fld_wrp">
                            <label for="form-label">City</label>
                            <input type="text" id="Ddl_City" class="form-control" value="@Model.parentVendorDto.City">
                        </div>
                    </div>

                    <div class="col-lg-6">
                        <div class="frm_fld_wrp">
                            <label class="form-label">Postal / Zip Code</label>
                            <input type="text" id="txt_ZipCode" class="form-control text-uppercase" value="@Model.parentVendorDto.ZipCode">
                        </div>
                    </div>

                    @* <div class="col-lg-6">
                        <div class="frm_fld_wrp">
                            <label class="form-label">Address(Press Enter for multiple lines)</label>
                            <textarea class="form-control" id="txt_Add1" style="height: 90px;">@Model.parentVendorDto.Address1</textarea>
                        </div>
                        <div class="frm_fld_wrp">
                            <label for="form-label">City</label>
                            <input type="text" id="Ddl_City" class="form-control" value="@Model.parentVendorDto.City">
                        </div>
                    </div>
                    <div class="col-lg-6">
                        <div class="frm_fld_wrp">
                            <label for="form-label">Country</label>
                            <select class="form-select" id="ddlCountry">
                                <option value="0" selected>--Select Country--</option>
                                @foreach (var item in Model.CountryList)
                                {
                                    if (Model.parentVendorDto.Country.ToString() == @item.CountryID.ToString())
                                    {
                                        <option value="@item.CountryID" selected>@item.Country</option>
                                    }
                                    else
                                    {
                                        <option value="@item.CountryID">@item.Country</option>
                                    }

                                }
                            </select>
                        </div>
                        <div class="frm_fld_wrp">
                            <label for="form-label">State/Prov</label>
                            <select class="form-select" id="ddlState">
