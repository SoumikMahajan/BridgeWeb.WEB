@{
    ViewData["Title"] = "Vendor List";
}

  <!-- breadcrumb -->
<div class="bread_cumb_wrp">
    <div class="container-fluid">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="@Url.Action("Dashboard", "Home")">Home</a></li>
                <li class="breadcrumb-item active" aria-current="page"><span>Vendors</span></li>
            </ol>
        </nav>
    </div>
</div>
<!-- breadcrumb -->
<!-- vendors list-->
<section class="master_wrap">
    <div class="container-fluid" id="vendor_list_tablebind">
        <h2 class="section_header">VENDORS</h2>
        <table id="vendorList_table" class="table table-striped table-hover vendor_table" style="width:100%">
            <thead>
                <tr>
                    <th>Common Name</th>
                    <th>Legal Name</th>
                    <th>Classification</th>
                    <th>City</th>
                    <th>Country</th>
                </tr>                
            </thead>
        </table>
    </div>
</section>
<!-- vendors list-->