
@model BridgeWeb.Domain.Model.MultipleModel
@{
    int index = 1;
}
<table id="edit_vendorcontact_info_table" class="table table-striped table-hover edit_vendorcontact_info_table" style="width:100%">

    <thead>
        <tr>
            <th>Action</th>
            <th>Active</th>
            <th>Hidden</th>
            <th>Contact</th>
            <th>Title</th>
            <th>E-mail</th>
            <th>City</th>
            <th>Phone</th>
            <th>Ext</th>
            <th>Mobile</th>
            <th></th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model.VendorContactUpdateDto)
        {
            <tr>
                <td class="text-center">
                    <div class="action_icons">
                        <i class="fa-solid fa-trash-can deleteVendorContact" title="Delete Contact" id="vendordel_@index" data-id="@item.VendorId" style="cursor:pointer;"></i>
                        <i class="fa-regular fa-pen-to-square vendorDetails" title="Edit Contact" data-id="@item.VendorId" id="vendor_@index" style="cursor:pointer;"></i>
                    </div>
                </td>
                <td class="activation">
                    @*  <i class="fa @(item.IsActive ?? false ? "fa-check-circle" : "fa-times-circle") activeVendorContact"></i> *@
                    @if (item.IsSystemUser == 1)
                    {
                        @if (item.IsActive == true)
                        {
                            <i class="fa fa-check-circle activeVendorContact" data-vid="@item.VendorId" data-active="@item.IsActive"></i>
                        }
                        else
                        {
                            <i class="fa fa-times-circle activeVendorContact" data-vid="@item.VendorId" data-active="@item.IsActive"></i>
                        }
                    }

                </td>
                @if (item.IsHidden == 0)
                {
                    <td>N</td>
                }
                else
                {
                    <td>Y</td>
                }
                <td>@item.VendorName</td>
                <td>@item.ContactTitle</td>
                <td> <a href="mailto:item.Email"></a>@item.Email</td>
                <td>@item.City</td>
                <td>@item.Phone</td>
                <td>@item.Extension</td>
                <td>@item.Mobile</td>
                <td>@(item.IsSystemUser == 1 ? item.IsActive : string.Empty)</td>
            </tr>
            index++;
        }
    </tbody>

</table>
