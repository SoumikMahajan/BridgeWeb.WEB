@{
    ViewData["Title"] = "Add Vendor";
}

@model BridgeWeb.Domain.Model.MultipleModel

<!-- breadcrumb -->
<div class="bread_cumb_wrp">
    <div class="container-fluid">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="@Url.Action("Dashboard", "Home")">Home</a></li>
                <li class="breadcrumb-item"><a href="@Url.Action("ContactList", "Vendors")">Vendors</a></li>
                <li class="breadcrumb-item active" aria-current="page"><span>Add Vendors</span></li>
            </ol>
        </nav>
    </div>
</div>
<!-- breadcrumb -->
<!-- add vendors -->
<section class="master_wrap add_vendor right_float_space">
    <div class="container-fluid">
        <h2 class="section_header">
            ADD VENDOR
            <a tabindex="0" class="global-popover" role="button" data-bs-toggle="popover"
               data-bs-content="Here you will add the vendor and the address for accounting purposes. Afterwards you will be prompted to add a contact">
                <i class="fa-solid fa-circle-info"></i>
            </a>
        </h2>
        <form action="#" id="addVendorForm">
            @Html.AntiForgeryToken()
            <div class="row custom_gutter5-x">
                <div class="col-lg-5">
                    <div class="invTermSlc">
                        <label for="invTerm">Invoice Terms: </label>
                        <select id="invTerm" class="form-select">
                            <option value="0">--Select Terms--</option>
                            @foreach (var item in Model.vendorTermsList)
                            {
                                if (item.TermID == 24)
                                {
                                    <option value="@item.TermID" selected>@item.Terms</option>
                                }
                                else
                                {
                                    <option value="@item.TermID">@item.Terms</option>
                                }
                            }
                        </select>
                    </div>
                </div>
            </div>

            <div class="row custom_gutter5-x">
                <div class="col-lg-2">
                    <div class="frm_fld_wrp">
                        <label class="form-label">Legal Name<span class="req">*</span></label>
                        <input type="text" id="txt_LegalName" class="form-control" style="text-transform:uppercase">
                    </div>
                </div>
                <div class="col-lg-2">
                    <div class="frm_fld_wrp">
                        <label class="form-label">Common Name<span class="req">*</span></label>
                        <input type="text" id="txt_Name" class="form-control" style="text-transform:uppercase">
                    </div>
                </div>
                <div class="col-lg-2">
                    <div class="frm_fld_wrp">
                        <label>Currency<span class="req">*</span></label>
                        <select class="form-select" id="Ddl_Currency">
                            <option value="0" selected>--Select Currency--</option>
                            @foreach (var item in Model.currencyList)
                            {
                                <option data-currcode="@item.CurrencyCode" value="@item.CurrencyID">@item.Currency</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="col-lg-6">
                    <div class="multi_slc_wrp">
                        <label for="" class="form-label">Classification</label>
                        <select multiple="multiple" class="multislct" data-width="100%" id="Ddl_Clftion">
                            @foreach (var item in Model.classificationsList)
                            {
                                <option value="@item.Classification_ID">@item.Classification</option>
                            }
                        </select>
                    </div>
                </div>
            </div>

            <div class="row custom_gutter5-x">
                <div class="col-lg-2">
                    <div class="frm_fld_wrp">
                        <label for="form-label">Address</label>
                        <textarea class="form-control address" id="txt_Addr"></textarea>
                    </div>
                    <div class="frm_fld_wrp">
                        <label for="form-label">City</label>
                        <input type="text" id="txt_City" class="form-control">
                    </div>
                </div>

                <div class="col-lg-2">
                    <div class="frm_fld_wrp">
                        <label for="form-label">Country</label>
                        <select class="form-select" id="ddlCountry">
                            <option value="0" selected>--Select Country--</option>
                            @foreach (var item in Model.CountryList)
                            {
                                <option value="@item.CountryID">@item.Country</option>
                            }
                        </select>
                    </div>
                    <div class="frm_fld_wrp">
                        <label for="form-label">State/Prov</label>
                        <select class="form-select" id="ddlState">
                            <option value="0" selected>--Select State--</option>
                        </select>
                    </div>
                    <div class="frm_fld_wrp">
                        <label for="form-label">Postal/Zip Code</label>
                        <input type="text" id="txt_ZipCode" class="form-control" style="text-transform:uppercase">
                    </div>
                </div>

                <div class="col-lg-4">
                    <div class="frm_fld_wrp">
                        <label for="form-label">Internal Notes</label>
                        <textarea class="form-control interNote" id="txt_VndrNotes"></textarea>
                    </div>
                </div>
            </div>

            <div class="row custom_gutter5-x">
                <div class="col-lg-2 addvendor_checkWrp">
                    <label for="minor_owner">
                        Minority Owned Business
                        <input type="checkbox" id="minor_owner">
                    </label>
                    <label for="women_owner">
                        Women Owned Business
                        <input type="checkbox" id="women_owner">
                    </label>
                    <label for="different_address">
                        Remit To address different than Main address
                        <input type="checkbox" id="different_address">
                    </label>
                </div>
            </div>

            <div class="row custom_gutter5-x d-none" id="remit_showhide">
                <div class="col-lg-2">
                    <div class="frm_fld_wrp">
                        <label for="form-label">Address</label>
                        <textarea class="form-control address" id="Rtxt_Addr"></textarea>
                    </div>

                    <div class="frm_fld_wrp">
                        <label for="form-label">City</label>
                        <input type="text" class="form-control" id="Rtxt_City">
                    </div>
                </div>

                <div class="col-lg-2">
                    <div class="frm_fld_wrp">
                        <label for="form-label">Country</label>
                        <select class="form-select" id="RDdl_Country">
                            <option value="0" selected>--Select Country--</option>
                            @foreach (var item in Model.CountryList)
                            {
                                <option value="@item.CountryID">@item.Country</option>
                            }
                        </select>
                    </div>

                    <div class="frm_fld_wrp">
                        <label for="form-label">State/Prov</label>
                        <select class="form-select" id="RDdl_State">
                            <option value="0" selected>--Select State--</option>
                        </select>
                    </div>

                    <div class="frm_fld_wrp">
                        <label for="form-label">Postal/Zip Code</label>
                        <input type="text" id="Rtxt_ZipCode" class="form-control">
                    </div>
                </div>
            </div>
        </form>



    </div>
</section>
<!-- add vendors -->
<!-- flote icon -->
<div class="flote_icon">
    <ul>
        <li>
            <a href="javascript:void(0);" id="btn_CrtPrntVndr" data-bs-toggle="tooltip" data-bs-placement="left" title="Save">
                <i class="fa fa-save"></i>
            </a>
        </li>
        <li>
            <a href="javascript:void(0);" data-bs-content="Cancel" data-bs-trigger="hover" data-bs-toggle="popover" id="btn_cancel">
                <i class="fa fa-remove"></i>
            </a>
        </li>
    </ul>
</div>
<!-- flote icon -->
