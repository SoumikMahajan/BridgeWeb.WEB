@{
    ViewData["Title"] = "Contact List";
}
<!-- breadcrumb -->
<div class="bread_cumb_wrp">
    <div class="container-fluid">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="@Url.Action("Dashboard", "Home")">Home</a></li>
                <li class="breadcrumb-item"><a href="@Url.Action("ContactList", "Vendors")">Vendors</a></li>
                <li class="breadcrumb-item active" aria-current="page"><span>CONTACTS</span></li>
            </ol>
        </nav>
    </div>
</div>
<!-- breadcrumb -->
<!-- contact list-->
<section class="master_wrap vendor_contact">
    <div class="container-fluid">
        <h2 class="section_header">VENDOR CONTACTS</h2>

        <div class="table-responsive" id="partialContactlist">

            <table id="contact_list" class="table table-striped table-hover contact_list" style="width:100%">

                <thead>
                    <tr>
                        <th>Action</th>
                        <th>Active</th>
                        <th>Hidden</th>
                        <th>Vendor Name</th>
                        <th>Classifications</th>
                        <th>Contact</th>
                        <th>Title</th>
                        <th>City</th>
                        <th>Phone</th>
                        <th>Email</th>                        
                    </tr>
                </thead>               
            </table>

        </div>
       
    </div>
</section>
<!-- contact list-->

<div id="sendmailvendortemplate" class="modal fade" tabindex="-1" aria-labelledby="exampleModalLabel"
     aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title">Send Mail</h4>
                <button type="button" class="modal-close" data-bs-dismiss="modal" aria-label="Close">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>
            <div class="modal-body">

                <div class="row mrg15T">

                    <div class="col-sm-3">
                        Add Dynamic field :
                    </div>
                    <div class="col-sm-6">
                        <select class="form-control" id="ddl_mail">
                            <option value="0">---Select---</option>
                            <option value="1">Log In Link</option>
                            <option value="USERNAME">User Name</option>
                            <option value="USEREMAIL">User Email</option>
                            <option value="USERPASSWORD">Password</option>

                        </select>
                    </div>

                </div>

                <div class="row mrg15T">

                    <div class="col-sm-3">
                        To :
                    </div>
                    <div class="col-sm-6">
                        <input type="text" class="form-control" id="pomailtos" disabled="disabled" />
                    </div>
                    <div class="col-sm-3">
                        <p id="mailcount__tot" class="mrg5T"></p>
                    </div>

                </div>


                <div class="row mrg15T">

                    <div class="col-sm-3">
                        Subject :
                    </div>
                    <div class="col-sm-6">
                        <input type="text" class="form-control" id="newusersubject" />
                    </div>

                </div>


                <div class="row mrg15T">
                    <div class="col-sm-12">
                        <textarea class="ckeditor" id="newusermail"></textarea>

                    </div>
                </div>





            </div>
            <div class="modal-footer">
                <span id="mailsenderloader"></span>
                <button type="button" class="gray_checkbtn" id="sendFinalMail">Send Mail</button>
            </div>
        </div>
    </div>
</div>


