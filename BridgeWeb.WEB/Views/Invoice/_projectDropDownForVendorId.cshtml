@model BridgeWeb.Domain.Model.MultipleModel
<select multiple="multiple" class="multislct" data-width="100%" id="txt_Project">
  @foreach (var items in Model.ProjectNameDropDown)
  {
    if (!string.IsNullOrEmpty(items.ProjectName) || !string.IsNullOrWhiteSpace(items.ProjectName))
    {

      <!option value="@items.ProjectID" >@items.ProjectNumber - @items.ProjectName</!option>
    }
  }
</select>
