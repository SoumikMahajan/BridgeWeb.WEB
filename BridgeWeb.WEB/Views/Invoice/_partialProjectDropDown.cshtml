@model BridgeWeb.Domain.Model.MultipleModel

<select multiple="multiple" class="multislct" data-width="100%" id="ddl_project">
    @if (Model.ProjectListEnterInvoice.Count()>0)
    {
        foreach (var item in Model.ProjectListEnterInvoice)
        {
            <!option value="@item.ProjectID" data-curr="@item.CurrencyCode" data-tax1="@item.Taxn1" data-tax2="@item.Taxn2" data-tax3="@item.Taxn3">@item.ProjectName</!option>
        }
    }
</select>