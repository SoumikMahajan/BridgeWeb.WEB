@model BridgeWeb.Domain.Model.MultipleModel

@{
    string FormatNumber(decimal? number)
    {
        if (!number.HasValue)
        {
            return "0.00";  // Return default value for null
        }

        // Round the number to 2 decimal places
        decimal roundedNumber = Math.Round(number.Value, 2);

        // Format with commas and two decimal places
        return roundedNumber.ToString("#,0.00", System.Globalization.CultureInfo.InvariantCulture);
    }
}


<table id="po_selector_Tax" class="table table-striped table-hover po_selector_table" style="width:100%">
    <thead>
        <tr>
            <th></th>
            <th>PO</th>
            <th>Curr</th>
            <th>Amount</th>
            <th>Remaning</th>
            <th class="d-none">Tax</th>
            <th class="d-none">ProjectID</th>  @* 6 *@
            <th class="d-none">VendorId</th>  @* 7 *@
            <th class="d-none">CRPO</th>
        </tr>
    </thead>

    <tbody>
        @if (Model.POSelectorList.Count() > 0)
        {
            foreach (var item in Model.POSelectorList)
            {
                <tr data-poid="@item.poid">
                    <td><input type="checkbox" class="poselector_chk" data-poid="@item.poid"></td>
                    <td><a class="redirectpoedit" style="color: #7792a8;text-decoration: none;cursor:pointer;" data-poid="@item.poid">@item.totalid</a></td>
                    <td>@item.currencycode</td>
                    <td>@(FormatNumber(item.total))</td>
                    <td>@(FormatNumber(item.remaining))</td>
                    <td class="d-none">@item.Tax</td>
                    <td>@item.projectid</td>
                    <td>@item.vendor_id</td>
                    <td>@item.CR</td>
                </tr>
            }
        }

        
    </tbody>
</table>