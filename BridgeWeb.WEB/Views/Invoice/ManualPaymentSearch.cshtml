<input type="hidden" id="hdnEditPaymentType" />
<input type="hidden" id="hdnEditBankAccount" />
<input type="hidden" id="hdnEditPaymentNumber" /> *@


@* payment history modal *@

<div class="modal fade payment_history_modal" id="payment_history_modal" tabindex="-1"
     aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title">Payment History</h1>
                <button type="button" class="modal-close" data-bs-dismiss="modal" aria-label="Close" data-bs-toggle="modal" data-bs-target="#edit_payment_modal">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>

            <div class="modal-body">
                <div class="row custom_gutter5-x">
                    <div id="paymenthistorybind"></div>


                </div>
            </div>

            <div class="modal-footer">
                <button class="offwhite_btn" data-bs-toggle="modal" data-bs-target="#edit_payment_modal">Cancel</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade updatedetails_modal" id="updatedetails_modal" tabindex="-1"
     aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title" id="headerupdatedetails">Payment History</h1>
                <button type="button" class="modal-close" data-bs-dismiss="modal" aria-label="Close" data-bs-toggle="modal" data-bs-target="#payment_history_modal">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>

            <div class="modal-body">
                <div class="row custom_gutter5-x">

                   <div id="paymentanditemupdatebind"><</div>
                   

                </div>
            </div>

            <div class="modal-footer">
                <button class="offwhite_btn" data-bs-toggle="modal" data-bs-target="#payment_history_modal">Cancel</button>
            </div>
        </div>
    </div>
</div>

<div id="qboDetailsModal" class="modal fade" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title">QBO Payment Lookup</h4>
                <button type="button" class="modal-close" data-bs-dismiss="modal" aria-label="Close">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>
            <div class="modal-body">
                <div id="qbStatus"></div>
            </div>
        </div>
    </div>
</div>

<div id="qboModal" class="modal fade" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="qboModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-md">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title" id="qboModalLabel">QBO Validating</h4>
                <button type="button" class="modal-close" data-bs-dismiss="modal" aria-label="Close">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>
            <div class="modal-body">
                <div id="qbCheck"></div>
            </div>
        </div>
    </div>
</div>

<div id="qbgeratemodal" class="modal fade" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="qboSendLabel" aria-hidden="true">
    <div class="modal-dialog modal-md">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title" id="qboSendLabel">QBO Sending Data</h4>
                <button type="button" class="modal-close" data-bs-dismiss="modal" aria-label="Close">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>
            <div class="modal-body">
                <div id="qbsendinfo"></div>
            </div>
        </div>
    </div>
</div>