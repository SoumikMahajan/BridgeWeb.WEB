@{
    ViewData["Title"] = "InvoiceEntry";
}

@model BridgeWeb.Domain.Model.MultipleModel

<!-- bredcrumb -->
<div class="bread_cumb_wrp">
    <div class="container-fluid">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="@Url.Action("Dashboard", "Home")">Home</a></li>
                <li class="breadcrumb-item"><a href="@Url.Action("invoicesearch", "Invoice")">Invoice</a></li>
                <li class="breadcrumb-item active" aria-current="page"><span>Enter Invoice</span></li>
            </ol>
        </nav>
    </div>
</div>
<!-- bredcrumb -->

<input type="hidden" id="hdn_vendorid" />
<input type="hidden" id="hdn_poid" />


<!-- Enter invoice section -->
<section class="master_wrap enter_inv right_float_space">
    <div class="container-fluid">
        <form action="#" id="invoice_entry_form">
            @Html.AntiForgeryToken()
            <div class="top_enter_inv_btn">
                <a href="@Url.Content("~/Invoice/InvoiceEntry_Tax")" class="gray_checkbtn" value="">ENTER INVOICE WITHOUT ITEM</a>
            </div>
            <div class="row custom_gutter5-x">
                <div class="col-lg-6">
                    <div class="veandprowrp">
                        <h2 class="section_header">VENDOR AND PROJECT</h2>
                        <div class="row align-items-end">
                            <div class="col-lg-6">
                                <div class="pull-left">
                                    <div class="multi_slc_wrp">
                                        <label for="" class="form-label">Vendor</label>
                                        <select multiple="multiple" class="multislct" data-width="100%" id="Ddl_Vendors">
                                            <!option value="0" selected>---Select Vendor---</!option>
                                            @if (Model.ParentVendorListEnterInvoice.Count() > 0)
                                            {
                                                foreach (var items in Model.ParentVendorListEnterInvoice)
                                                {
                                                    <!option value="@items.Vendor_ID" data-curr="@items.Currency">@items.NAME </!option>
                                                }
                                            }
                                        </select>
                                    </div>
                                    <div class="multi_slc_wrp">
                                        <label for="" class="form-label">Project</label>
                                        <div id="projectlistbind"></div>

                                    </div>
                                </div>
                            </div>
                            <div class="col-lg-6">
                                <div class="pull-right">
                                    <div class="frm_fld_wrp">
                                        <label for="form-label" id="lblLegal" class="d-block"></label>
                                        @* <textarea class="form-control" id="lblAddress" disabled></textarea> *@
                                        <a target="_blank">
                                            <textarea class="form-control mrg10T" id="lblAddress" rows="4" cols="35"
                                                      disabled="disabled" style="resize: none; margin-top:0px; cursor: pointer; pointer-events: none;"></textarea>
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-lg-6">
                    <div class="invoice_data">
                        <h2 class="section_header">INVOICE DATA</h2>
                        <div class="row custom_gutter5-x">
                            <div class="col-lg-2">
                                <div class="frm_fld_wrp">
                                    <label for="" class="form-label">Date</label>
                                    <input type="text" class="form-control datepicker" id="txt_InvoiceDate">
                                </div>
                            </div>
                            <div class="col-lg-4">
                                <div class="frm_fld_wrp nsaqbo">
                                    <label for="" class="form-label">
                                        Terms <i class="fa-solid fa-plus new_termpopup"
                                                 data-bs-toggle="modal" data-bs-target="#terms_popup"></i>
                                    </label>
                                    <select name="" id="ddl_terms" class="form-select">
                                        <option value="0">--Select Terms--</option>
                                        @if (Model.vendorTermsList.Count() > 0)
                                        {
                                            foreach (var items in Model.vendorTermsList)
                                            {

                                                <option value="@items.TermID">@items.Terms</option>
                                            }
                                        }

                                    </select>
                                </div>
                            </div>
                            <div class="col-lg-3">
                                <div class="frm_fld_wrp">
                                    <label for="" class="form-label">Number</label>
                                    <input type="text" class="form-control right-txt" id="txt_InvoiceNumber">
                                </div>
                            </div>
                            <div class="col-lg-3">
                                <div class="frm_fld_wrp">
                                    <label for="" class="form-label">
                                        Total Amt.
                                    </label>
                                    <input type="number" class="form-control right-txt" id="txt_TotalInvoiceAmount">
                                </div>
                            </div>

                            <div class="col-lg-6">
                                <div class="frm_fld_wrp nsaqbo">
                                    <label for="" class="form-label">
                                        <span>Project Account</span><span id="bnkbalance">

                                        </span>
                                    </label>

                                    <select name="" id="Ddl_ProjectAccount" class="form-select">
                                        <option value="0">Cash on hand - Project account</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-lg-3">
                                <div class="frm_fld_wrp">
                                    <label for="" class="form-label">Fx Rate</label>
                                    <input type="number" class="form-control right-txt" id="exchngrate" data-edited="N">
                                </div>
                            </div>
                            <div class="col-lg-3">
                                <div class="frm_fld_wrp inv_memo">
                                    <label for="" class="form-label">Invoice Memo</label>
                                    <textarea name="" id="txt_InvoiceMemo" class="form-control"></textarea>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-lg-5">
                    <h2 class="section_header">PO SELECTOR</h2>
                    <div id="poselectortblbind"></div>

                </div>

                <div class="col-lg-7">
                    <h2 class="section_header">ITEM SELECTOR</h2>
                    <div id="polineitemtblbind"></div>

                </div>

                <div class="col-lg-7 offset-lg-5">
                    <div class="row_shifter">
                        <div class="frm_fld_wrp">
                            <label for="" class="form-label">Apply %</label>
                            <input type="text" class="form-control right-txt" id="percentage" data-maxval="100" value="100">
                        </div>
                        <div class="shift_btns">
                            <button type="button" id="singleSelect" class="global-popover" title="Select Selected"><i class="fa-solid fa-angle-down"></i></button>
                            <button type="button" id="selectall" class="global-popover" title="Select All"><i class="fa-solid fa-angles-down"></i></button>
                            <button type="button" id="unselectSelected" class="global-popover" title="Unselect Selected"><i class="fa-solid fa-angle-up"></i></button>
                            <button type="button" id="unselectAll" class="global-popover" title="Unselect All"><i class="fa-solid fa-angles-up"></i></button>
                            <div class="line_adjustment_btn d-none" id="adjustbtn">
                                <i class="fa fa-plus-circle global-popover" aria-hidden="true" title="Increase selected value by 1 cent" id="increaseval"></i>
                                <i class="fa fa-minus-circle ms-1" aria-hidden="true" title="Decrease selected value by 1 cent" id="decreaseval"></i>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-12">
                    <h2 class="section_header">INVOICE ITEMS</h2>
                    <div id="invoiceitemtblbind"></div>


                    <div class="total_inputs">
                        <div class="total_inputs_row">
                            <div class="total_inputs_col">
                                <label for="" class="form-label">Subtotal Invoice</label>
                            </div>
                            <div class="total_inputs_col">
                                <input type="text" class="form-control" id="txt_SubtotalInvoice" disabled>
                            </div>
                        </div>
                        <div class="total_inputs_row">
                            <div class="total_inputs_col">
                                <label for="" class="form-label" id="tt1">Total Tax 1</label>
                            </div>
                            <div class="total_inputs_col">
                                <input type="text" class="floatonly form-control" id="txt_TotalTax1">
                            </div>
                        </div>
                        <div class="total_inputs_row">
                            <div class="total_inputs_col">
                                <label for="" class="form-label " id="tt2">Total Tax 2</label>
                            </div>
                            <div class="total_inputs_col">
                                <input type="text" class="form-control floatonly" id="txt_TotalTax2">
                            </div>
                        </div>
                        <div class="total_inputs_row">
                            <div class="total_inputs_col">
                                <label for="" class="form-label" id="tt3">Total Tax 3</label>
                            </div>
                            <div class="total_inputs_col">
                                <input type="text" class="form-control floatonly " id="txt_TotalTax3">
                            </div>
                        </div>
                        <div class="total_inputs_row">

                            <div class="total_inputs_col">
                                <label for="" class="form-label">Total Invoice</label>
                            </div>

                            <div class="total_inputs_col">
                                <input type="text" class="form-control" id="txt_TotalInvoice" value="" disabled>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </form>
    </div>
</section>
<!-- Enter invoice section-->
<!-- flote icon -->
<div class="flote_icon">
    <ul>
        <li>
            <a href="#" class="global-popover" data-bs-toggle="popover" data-bs-trigger="hover" data-bs-content="Save" id="btn_Save">
                <i class="fa-regular fa-floppy-disk"></i>
            </a>
        </li>
        <li>
            <a href="#" class="global-popover" data-bs-toggle="popover" data-bs-trigger="hover" data-bs-content="Cancel" id="btn_Cancel">
                <i class="fa-solid fa-xmark"></i>
            </a>
        </li>
    </ul>
</div>
<!-- flote icon -->
<!-- Modal -->
<div class="modal fade terms_popup" id="terms_popup" tabindex="-1" aria-labelledby="exampleModalLabel"
     aria-hidden="true">
    <div class="modal-dialog modal-md">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title">Add New Terms</h1>
                <button type="button" class="modal-close" data-bs-dismiss="modal" aria-label="Close">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>
            <div class="modal-body">
                <div class="frm_fld_wrp">
                    <label for="" class="form-label">Invoice Terms</label>
                    <input type="text" class="form-control" id="txtInvoiceTerms">
                </div>
                <label for="selectafterchecking" class="sel_aft_add">
                    Select After Adding <input type="checkbox" checked id="selectafterchecking">
                </label>
            </div>
            <div class="modal-footer">
                <button type="button" class="offwhite_btn" id="addnewterms">Save</button>
            </div>
        </div>
    </div>
</div>


<div class="modal fade" id="previnvoice" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title">Invoices</h1>
                <button type="button" class="modal-close" data-bs-dismiss="modal" aria-label="Close">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>
            <div class="modal-body">
                <div id="previnvlistbind"></div>

            </div>
            <div class="modal-footer">
                <button type="button" class="offwhite_btn" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>