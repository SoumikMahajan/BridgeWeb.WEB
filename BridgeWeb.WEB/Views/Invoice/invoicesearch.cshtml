@model BridgeWeb.Domain.Model.MultipleModel
@{
    ViewData["Title"] = "Search Invoice";
}

<input type="hidden" id="poidhdn" value="@ViewData["poidhdn"]" />


<div class="bread_cumb_wrp">
    <div class="container-fluid">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="@Url.Action("Dashboard", "Home")">Home</a></li>
                <li class="breadcrumb-item"><a href="@Url.Action("invoicesearch", "Invoice")">INVOICE</a></li>
                <li class="breadcrumb-item active" aria-current="page"><span>SEARCH INVOICE</span></li>
            </ol>
        </nav>
    </div>
</div>
<!-- breadcrumb -->
<!-- Report section -->
<section class="master_wrap">
    <div class="container-fluid">
        <div class="invoice_search_wrp">
            <h2 class="section_header">INVOICE SEARCH</h2>
            <div class="row custom_gutter5-x">
                <div class="col-lg-3">
                    <div class="multi_slc_wrp">
                        <label for="" class="form-label">Vendor</label>
                        @*   <div id="vendorlisting"></div> *@
                        <select multiple="multiple" class="multislct vendorlist" data-width="100%" id="txt_Project3">

                            @foreach (var items in Model.ParentVendorListInvoice)
                            {
                                <option value="@items.VendorId">@items.Name</option>
                            }
                        </select>
                    </div>
                </div>

                <div class="col-lg-2">
                    <div class="frm_fld_wrp">
                        <label for="" class="form-label">Vendor Invoice #</label>
                        <input type="text" class="form-control" id="txt_invoice">
                    </div>
                </div>

                <div class="col-lg-1">
                    <div class="frm_fld_wrp">
                        <label for="" class="form-label">Date</label>
                        <select name="" class="form-select datecontrol" data-from="fromsearch" data-to="tosearch">
                            <option value="All">ALL</option>
                            <option value="custom">Custom</option>
                            <option value="last365">Last 365 Days</option>
                            <option value="today">Today</option>
                            <option value="yesterday">Yesterday</option>
                            <option value="thisweek">This Week</option>
                            <option value="thismonth">This Month</option>
                            <option value="thisquarter">This Quarter</option>
                            <option value="thisyear">This Year</option>
                            <option value="lastweek">Last Week</option>
                            <option value="lastmonth">Last Month</option>
                            <option value="lastquarter">Last Quater</option>
                            <option value="lastyear">Last Year</option>
                        </select>
                    </div>
                </div>

                <div class="col-lg-1">
                    <div class="frm_fld_wrp">
                        <label for="" class="form-label">From</label>
                        <input type="text" class="form-control datepicker" placeholder="YYYY.MM.DD" id="fromsearch" disabled>
                    </div>
                </div>

                <div class="col-lg-1">
                    <div class="frm_fld_wrp">
                        <label for="" class="form-label">To</label>
                        <input type="text" class="form-control datepicker" placeholder="YYYY.MM.DD" id="tosearch" disabled>
                    </div>
                </div>

                <div class="col-lg-3">
                    <div class="multi_slc_wrp">
                        <label for="" class="form-label">Project</label>
                     
                        <div id="projectNameBind"></div>
                    </div>
                </div>

                <div class="col-lg-1">
                    <button type="button" class="gray_checkbtn" id="searchinvoicebtn">Search</button>
                </div>
            </div>
        </div>

        <div class="invoice_list">
            <h2 class="section_header">INVOICE LIST</h2>
            <table id="tableonpageload" class="table table-striped table-hover" style="width:100%">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Vendor</th>
                        <th>Invoice #</th>
                        <th>Project</th>
                        <th>Currency</th>
                        <th>Fx Rate</th>
                        <th>Subtotal</th>
                        <th>Tax1</th>
                        <th>Tax2</th>
                        <th>Tax3</th>
                        <th>Payment</th>
                    </tr>
                </thead>
                <tbody>
                   
                </tbody>
            </table>
            <div class="table_responsive" id="invoicelist"></div>
           
        </div>
    </div>
</section>