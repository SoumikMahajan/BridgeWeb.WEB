@model BridgeWeb.Domain.Model.MultipleModel
@{
    string FormatNumber(decimal? number)
    {
        if (!number.HasValue)
        {
            return "0.00";  // Return default value for null
        }

        // Round the number to 2 decimal places
        decimal roundedNumber = Math.Round(number.Value, 2);

        // Format with commas and two decimal places
        return roundedNumber.ToString("#,0.00", System.Globalization.CultureInfo.InvariantCulture);
    }
}
<table id="inv_selector" class="table table-striped table-hover inv_selector_table" style="width:100%">
    <thead>
        <tr>
            <th style="width: 5%;"><input type="checkbox" id="checkAll"></th>
            <th style="width: 15%;">Vendor</th>
            <th style="width: 10%;">Invoice #</th>
            <th style="width: 10%;">Date</th>
            <th style="width: 20%;">Terms</th>
            <th style="width: 10%;">Currency</th>
            <th style="width: 10%;">Amount Owing</th>
            <th style="width: 10%;">Payment Amount</th>
        </tr>
    </thead>

    <tbody>
        @if (Model.GetAllInvoiceListinMP.Count()>0)
        {
            foreach (var items in Model.GetAllInvoiceListinMP)
            {
                var totalInvoice = items.TotalInvoice - items.Paid;
                if (totalInvoice != 0)
                {
                    <tr data-invid="@items.InvoiceNumber" data-parentvendorid="@items.ParentVendor_ID" >
                        <td><input type="checkbox" class="chkItems"></td>
                        <td>@items.ParentVendorName</td>
                        <td>@items.InvoiceNumberVendor</td>
                        <td>@items.InvoiceDate</td>
                        <td>@(items.Terms ?? string.Empty)</td>
                        <td>@items.Currency</td>
                        <td>@FormatNumber(items.TotalInvoice)</td>
                        <td>
                            <input type="text" class="itempa"data-exrate="@items.Exrate" data-maxValCheck="@items.TotalInvoice" class="form-control payamt" disabled="disabled" value="0.00">
                        </td>
                    </tr>
                }
            }
        }
        
       
    </tbody>
</table>