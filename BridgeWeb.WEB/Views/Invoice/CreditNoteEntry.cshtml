@{
    ViewData["Title"] = "Credit Note Entry";
}
@model BridgeWeb.Domain.Model.MultipleModel

<!-- bredcrumb -->
<div class="bread_cumb_wrp">
    <div class="container-fluid">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="@Url.Action("Dashboard", "Home")">Home</a></li>
                <li class="breadcrumb-item"><a href="@Url.Action("invoicesearch", "Invoice")">Invoice</a></li>
                <li class="breadcrumb-item active" aria-current="page"><span>Enter Credit Note</span></li>
            </ol>
        </nav>
    </div>
</div>
<!-- bredcrumb -->

<input type="hidden" id="hdn_poid" value="" />

<section class="master_wrap enter_inv">
    <div class="container-fluid">
        <div class="top_enter_inv_btn">
            <a href="@Url.Content("~/Invoice/CreditEntry_Tax")" class="gray_checkbtn">ENTER CREDIT NOTE WITHOUT ITEM</a>
        </div>
        <form class="row custom_gutter5-x" id="credit_note_entry_form">
            @Html.AntiForgeryToken()
            <div class="col-lg-3">
                <div class="veandprowrp">
                    <h2 class="section_header">CREDIT NOTE</h2>
                    <div class="pull-left">
                        <div class="multi_slc_wrp">
                            <label for="Ddl_Vendors" class="form-label">Vendor</label>
                            <select multiple="multiple" class="multislct" data-width="100%" id="Ddl_Vendors">
                                <!option value="0" selected>--Select Vendor--</!option>

                                @if (Model.VendorListinECN.Count() > 0)
                                {
                                    foreach (var items in Model.VendorListinECN)
                                    {
                                        <!option data-curr="@items.Currency" value="@items.ParentVendorId">@items.ParentVendorname</!option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="multi_slc_wrp">
                            <div id="plbind"></div>


                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-9">
                <div class="invoice_data">
                    <h2 class="section_header">CREDIT NOTE DATA</h2>
                    <div class="row custom_gutter5-x">
                        <div class="col-lg-2">
                            <div class="frm_fld_wrp">
                                <label for="txt_InvoiceDate" class="form-label">Date</label>
                                <input type="text" class="form-control datepicker" id="txt_InvoiceDate">
                            </div>
                        </div>
                        <div class="col-lg-3">
                            <div class="frm_fld_wrp">
                                <label for="txt_InvoiceNumber" class="form-label">Number</label>
                                <input type="text" value="CR-" class="form-control" id="txt_InvoiceNumber">
                            </div>
                        </div>
                        <div class="col-lg-1">
                            <div class="frm_fld_wrp">
                                <label for="exchngrate" class="form-label">Fx Rate</label>
                                <input type="number" value="1.0000" class="form-control right-txt" id="exchngrate">
                            </div>
                        </div>
                        <div class="col-lg-3">
                            <div class="frm_fld_wrp">
                                <label for="Ddl_ProjectAccount" class="form-label">
                                    <span>Project Account</span><span id="bnkbalance">

                                </span>
                            </label>
                            <select name="" id="Ddl_ProjectAccount" class="form-select">
                                <option value="0">--Select Project Account--</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-lg-3">
                        <div class="frm_fld_wrp inv_memo">
                            <label for="txt_InvoiceMemo" class="form-label">Credit Memo</label>
                            <textarea name="" id="txt_InvoiceMemo" class="form-control"></textarea>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-5">
            <h2 class="section_header">PO SELECTOR</h2>
            <div id="poselectorincnbind"></div>

        </div>

        <div class="col-lg-7">
            <h2 class="section_header">ITEM SELECTOR</h2>
            <div id="poitemselectorcn"></div>

        </div>

        <div class="col-lg-7 offset-lg-5">
            <div class="row_shifter">
                @* <div class="frm_fld_wrp"> *@
                @*     <label for="" class="form-label">Apply %</label> *@
                @*     <input type="text" class="form-control right-txt"> *@
                @* </div> *@
                <div class="shift_btns">
                    <button type="button" id="singleSelect" class="global-popover" title="Select Selected"><i class="fa-solid fa-angle-down"></i></button>
                    <button type="button" id="selectall" class="global-popover" title="Select All"><i class="fa-solid fa-angles-down"></i></button>
                    <button type="button" id="unselectSelected" class="global-popover" title="Unselect Selected"><i class="fa-solid fa-angle-up"></i></button>
                    <button type="button" id="unselectAll" class="global-popover" title="Unselect All"><i class="fa-solid fa-angles-up"></i></button>
                </div>
            </div>
        </div>

        <div class="col-12">
            <h2 class="section_header">CREDIT ITEMS</h2>

            <div id="invoiceitemdetialscn"></div>


            <div class="total_inputs">
                <div class="total_inputs_row">
                    <div class="total_inputs_col">
                        <label for="txt_SubtotalInvoice" class="form-label">Subtotal Invoice</label>
                    </div>
                    <div class="total_inputs_col">
                        <input type="text" class="form-control " id="txt_SubtotalInvoice" disabled>
                    </div>
                </div>
                <div class="total_inputs_row">
                    <div class="total_inputs_col">
                        <label for="txt_TotalTax1" class="form-label">Total Tax 1</label>
                    </div>
                    <div class="total_inputs_col">
                        <input type="text" class="form-control floatonly" id="txt_TotalTax1">
                    </div>
                </div>
                <div class="total_inputs_row">
                    <div class="total_inputs_col">
                        <label for="txt_TotalTax2" class="form-label">Total Tax 2</label>
                    </div>
                    <div class="total_inputs_col">
                        <input type="text" class="form-control floatonly" id="txt_TotalTax2">
                    </div>
                </div>
                <div class="total_inputs_row">
                    <div class="total_inputs_col">
                        <label for="txt_TotalTax3" class="form-label">Total Tax 3</label>
                    </div>
                    <div class="total_inputs_col">
                        <input type="text" class="form-control floatonly" id="txt_TotalTax3">
                    </div>
                </div>
                <div class="total_inputs_row">
                    <div class="total_inputs_col">
                        <label for="txt_TotalInvoice" class="form-label">Total Invoice</label>
                    </div>

                    <div class="total_inputs_col">
                        <input type="text" class="form-control " id="txt_TotalInvoice" disabled>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>
</section>

<!-- flote icon -->
<div class="flote_icon">
    <ul>
        <li>
            <a href="javascript:void(0);" class="global-popover" data-bs-toggle="popover" data-bs-trigger="hover" data-bs-content="Save" id="btn_save">
                <i class="fa-regular fa-floppy-disk"></i>
            </a>
        </li>
        <li>
            <a href="javascript:void(0);" class="global-popover" data-bs-toggle="popover" data-bs-trigger="hover" data-bs-content="Cancel" id="btn_cancel">
                <i class="fa-solid fa-xmark"></i>
            </a>
        </li>
    </ul>
</div>
<!-- flote icon -->
<!-- Modal -->
<div class="modal fade terms_popup" id="terms_popup" tabindex="-1" aria-labelledby="exampleModalLabel"
     aria-hidden="true">
    <div class="modal-dialog modal-md">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title">Add New Terms</h1>
                <button type="button" class="modal-close" data-bs-dismiss="modal" aria-label="Close">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>
            <div class="modal-body">
                <div class="frm_fld_wrp">
                    <label  class="form-label">Invoice Terms</label>
                    <input type="text" class="form-control">
                </div>
                <label for="selectafterchecking" class="sel_aft_add">
                    Select After Adding <input type="checkbox"
                                               id="selectafterchecking">
                </label>
            </div>
            <div class="modal-footer">
                <button type="button" class="offwhite_btn" data-bs-dismiss="modal">Save</button>
            </div>
        </div>
    </div>
</div>


<div class="modal fade" id="previnvoice" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title">Invoices</h1>
                <button type="button" class="modal-close" data-bs-dismiss="modal" aria-label="Close">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>
            <div class="modal-body">
                <div id="previnvlistbind"></div>

            </div>
            <div class="modal-footer">
                <button type="button" class="offwhite_btn" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>



<div class="modal fade itemeditpopup" id="itemeditpopup" tabindex="-1" aria-labelledby="exampleModalLabel"
     aria-hidden="true">
    <div class="modal-dialog big-modal">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title text-uppercase">Adjust PO Items</h1>
                @* <button type="button" class="modal-close" data-bs-dismiss="modal" aria-label="Close"> *@
                @*     <i class="fa-solid fa-xmark"></i> *@
                @* </button> *@
            </div>
            <div class="modal-body">
                <div id="itemonsavebind"></div>

            </div>
            <div class="modal-footer">
                <button type="button" class="offwhite_btn" data-bs-dismiss="modal">Close</button>
                <button type="button" class="offwhite_btn" id="save_btnitem_cm">Save Item(s) and Credit Memo</button>

            </div>
        </div>
    </div>
</div>
