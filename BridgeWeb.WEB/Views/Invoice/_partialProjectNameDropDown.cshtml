@model BridgeWeb.Domain.Model.MultipleModel
<select multiple="multiple" class="multislct" data-width="100%" id="txt_Project">
    @foreach (var items in Model.ProjectNameDropDown)
    {
        if (!string.IsNullOrWhiteSpace(items.ProjectName) || !string.IsNullOrEmpty(items.ProjectName))
        {
            <option value="@items.ProjectID">@items.ProjectName</option>
        }

    }
</select>
