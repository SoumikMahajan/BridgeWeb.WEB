@model MultipleModel

<table class="table table-striped table-hover" id="history_table" style="width:100%">
    <thead>
        <tr>
            <th>User</th>
            <th>Action</th>
            <th>Date</th>
        </tr>
    </thead>
    <tbody>
        @foreach(var item in Model.AllPoHistoryDetails)
        {
            var mode = string.Empty;
            if (item.Mode == "PO_UPDATE")
            {
                mode = $"PO UPDATE <i style='cursor:pointer;' class='fa fa-info-circle inner_info_btn' data-flid='{item.FldID}' aria-hidden='true'></i>";
            }
            else if (item.Mode == "POITEM_UPDATE")
            {
                mode = $"PO ITEM UPDATE <i style='cursor:pointer;' class='fa fa-info-circle getUpdatedFieldDetailsItem' data-flid='{item.FldID}' aria-hidden='true'></i>";
            }
            else if (item.Mode == "POITEM_CREATE")
            {
                mode = $"PO ITEM CREATED <i style='cursor:pointer;' class='fa fa-info-circle getUpdatedFieldDetailsItem' data-flid='{item.FldID}' aria-hidden='true'></i>";
            }
            else if (item.Mode == "POITEM_DELETED")
            {
                mode = $"PO ITEM DELETE <i style='cursor:pointer;' class='fa fa-info-circle getUpdatedFieldDetailsItem' data-flid='{item.FldID}' aria-hidden='true'></i>";
            }
            else
            {
                mode = item.Mode == null?"": item.Mode.Replace('_', ' ');
            }

            <tr>
                <td>@item.User</td>
                <td>@Html.Raw(mode) @(item.FldID == 56874 ? "*":"")</td>
                <td>@item.OperationONShow</td>
            </tr>           
        }
    </tbody>
</table>
