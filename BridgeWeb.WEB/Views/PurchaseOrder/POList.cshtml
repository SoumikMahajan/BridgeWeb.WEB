@model MultipleModel
@{
    ViewData["Title"] = "Purchase Order ";
}

@{
    var VendorID=ViewData["VendorID"] ;
    var Status = ViewData["Status"];
    var ProjectId = ViewData["poidprev"];
    var ProjectUrl = ViewData["ProjectIdFromUrl"];
}
<!-- breadcrumb -->
<div class="bread_cumb_wrp">
    <div class="container-fluid">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="@Url.Action("Dashboard", "Home")">Home</a></li>
                <li class="breadcrumb-item"><a href="@Url.Action("POList", "PurchaseOrder")">PURCHASE ORDERS</a></li>
                <li class="breadcrumb-item active" aria-current="page"><span>SEARCH PURCHASE ORDER</span></li>
            </ol>
        </nav>
    </div>
</div>
<!-- breadcrumb -->
<input type="hidden" id="hdn_projectId" value="@ProjectId" />
<input type="hidden" id="hdn_vendorid" value="@VendorID" />
<input type="hidden" id="hdn_status" value="@Status" />
<input type="hidden" id="hdn_projecturl" value=" @ProjectUrl" />

<!-- Search Purchase Order section -->
<section class="master_wrap search_purchase_order">
    <div class="container-fluid">
        <div class="row">
            <div class="col-lg-3">
                <div class="deleted_po_btn">
                    <button type="button" class="solid_teal_btn" id="deletedPOListPageBtn">
                        <i class="fa-solid fa-list-ul"></i>Show
                        deleted PO
                    </button>
                </div>
            </div>
        </div>

        <div class="purchase_orde_wrp">
            <h2 class="section_header">PURCHASE ORDER SEARCH</h2>
            <div class="row custom_gutter5-x">
                <div class="col-lg-2">
                    <div class="frm_fld_wrp">
                        <label for="" class="form-label">Purchase Order Number</label>
                        <input type="text" class="form-control" placeholder="Enter Purchase Order" id="purchaseOrderNumber" name="purchaseOrderNumber">
                    </div>
                </div>
                <div class="col-lg-2">
                    <div class="multi_slc_wrp">
                        <label for="" class="form-label">Project Number</label>
                        <select multiple="multiple" class="multislct" data-width="100%" id="projectNumber" name="projectNumber">
                            @* <option value="0">--Select Project--</option> *@
                            @if (Model.dropDownListDTOs != null)
                            {
                                @foreach (var item in Model.dropDownListDTOs)
                                {
                                    <option value="@item.Id" data-id="@item.Id">@item.Name</option>
                                }
                            }
                        </select>
                    </div>
                </div>
                <div class="col-lg-2">
                    <div class="multi_slc_wrp">
                        <label for="" class="form-label">Section</label>
                        <select multiple="multiple" class="multislct" data-width="100%" id="projectSection" name="projectSection">
                        </select>
                    </div>
                </div>
                <div class="col-lg-2">
                    <div class="multi_slc_wrp">
                        <label for="" class="form-label">Vendor</label>
                        <select multiple="multiple" class="multislct" data-width="100%" id="projectVendor" name="projectVendor">
                        </select>
                    </div>
                </div>

                <div class="col-lg-2">
                    <div class="frm_fld_wrp">
                        <label for="" class="form-label">Item/Spec</label>
                        <input type="text" class="form-control" placeholder="Enter Text" id="item_Spec" name="item_Spec">
                    </div>
                </div>
                <div class="col-lg-2">
                    <div class="frm_fld_wrp">
                        <label for="" class="form-label">Remarks</label>
                        <input type="text" class="form-control" placeholder="Enter Text" id="remarks" name="remarks">
                    </div>
                </div>
            </div>
            <div class="src_btn_wrp">
                <button type="button" class="solid_teal_btn" id="advanceSearch">
                    <i class="fa-solid fa-magnifying-glass"></i>Search
                </button>
            </div>
        </div>

        <!---- HIDDEN VARIABLE ---->

        <input type="hidden" id="poEditPermission" />
        <input type="hidden" id="userType" value="@ViewData["usertype"]" />
        <input type="hidden" id="prevPoId" value="@ViewData["poidprev"]" />
        <input type="hidden" id="vendorPoId" value="@ViewData["POID"]" />
        <input type="hidden" id="status" value="@ViewData["Status"]" />
        <input type="hidden" id="vendorId" value="@ViewData["VendorID"]" />
        <input type="hidden" id="projectId" value="@ViewData["ProjectID"]" />
        <input type="hidden" id="projecturl" value="@ViewData["ProjectIdFromUrl"]" />
        <h2 class="section_header">PURCHASE ORDERS LIST</h2>
        <div id="POItemLoader" style=" text-align:center; padding:20px;">
            <i class="fa fa-spinner fa-spin"></i> Loading...
        </div>
        <div id="purchaseOrderTableDiv"></div>
        <div id="dialog-confirm"></div>

    </div>
</section>
<!-- Purchase Order section-->
<!-- flote icon -->
<div class="flote_icon hidden_flote">
    <ul>
        <li data-bs-toggle="modal" data-bs-target="#send_po_approv" id="approvalBtn" class="displayNone">
            <a href="#" data-bs-toggle="popover" data-bs-content="Send For Approval Batch" data-bs-trigger="hover">
                <span class="count" id="approvalCount">0</span>
                <i class="fa-regular fa-share-from-square"></i>
            </a>
        </li>
        <li data-bs-toggle="modal" data-bs-target="#send_mail_modal" id="mailBtn" class="displayNone">
            <a href="#" data-bs-toggle="popover" data-bs-content="Send To Vendor Batch" data-bs-trigger="hover">
                <span class="count" id="mailCount">0</span>
                <i class="fa fa-paper-plane"></i>
            </a>
        </li>
        <li data-bs-toggle="modal" data-bs-target="#download_files" id="downloadBtn" class="displayNone">
            <a href="#" data-bs-toggle="popover" data-bs-content="Download PO/Attachment" data-bs-trigger="hover">
                <span class="count" id="downloadCount">0</span>
                <i class="fa fa-download"></i>
            </a>
        </li>
    </ul>
</div>
<!-- flote icon -->

<!-- Modal -->
<div class="modal fade download_files" id="download_files" tabindex="-1" aria-labelledby="exampleModalLabel"
     aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title">DOWNLOAD SELECTED FILES</h1>
                <button type="button" class="modal-close" data-bs-dismiss="modal" aria-label="Close">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>

            <div class="modal-body">
                <div class="row">
                    <div class="col-lg-6">
                        <h2 class="section_header"><input type="checkbox" checked id="checkuncheckallpdfs">PURCHASE ORDER PDF(S)</h2>
                        <div class="po_pdf">
                            <div class="po_pdf_list" id="poPDFDownload">
                            </div>
                        </div>
                    </div>

                    <div class="col-lg-6">
                        <h2 class="section_header"><input type="checkbox" checked id="checkuncheckallattachments">ATTACHMENTS</h2>
                        <div class="down_attact">
                            <div class="down_attact_list" id="poAttachmentDownload">
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="gray_checkbtn" id="unselectBtn">
                    CANCEL AND REMOVE
                    UNSELECTED
                </button>
                <button type="button" class="gray_checkbtn" id="downloadFilesBtn">DOWNLOAD SELECTED FILES</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade send_mail_modal" id="send_mail_modal" tabindex="-1" aria-labelledby="exampleModalLabel"
     aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title">Send Mail</h1>
                <button type="button" class="modal-close" data-bs-dismiss="modal" aria-label="Close">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>

            <div class="modal-body">
                <div class="mail_top">
                    <div class="row">
                        <div class="col-lg-3">
                            <label>To:</label>
                        </div>
                        <div class="col-lg-9">
                            <input type="text" class="form-control" id="vendorMailIds">
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-lg-3">
                            <label>Subject:</label>
                        </div>
                        <div class="col-lg-9">
                            <input type="text" class="form-control" id="subject">
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-lg-3">
                            <label>Add Dynamic field :</label>
                        </div>
                        <div class="col-lg-9">
                            <select name="" id="mailDynamicField" class="form-select">
                                <option value="1">Link to Home</option>
                                <option value="PROJECTNAME">Project Name</option>
                                <option value="PROJECTNUMBER">Project Number</option>
                                <option value="PONUMBER">PO Number</option>
                                <option value="VENDORNAME">Vendor Name</option>
                                <option value="CONTACTNAME">Contact Name</option>
                                <option value="USERNAME">User Name</option>
                                <option value="USERADDRESS">User Address</option>
                            </select>
                        </div>
                    </div>
                </div>
                <textarea id="editor" class="ckeditor"></textarea>
            </div>

            <div class="modal-footer">
                <div class="cc_mail_btn">
                    <label>Add self to CC <input type="checkbox" id="selfCC"></label>
                </div>
                <button type="button" class="offwhite_btn" id="sendMailBtn">Send Mail</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade send_po_approv" id="send_po_approv" tabindex="-1" aria-labelledby="exampleModalLabel"
     aria-hidden="true">
    <div class="modal-dialog modal-md">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title">SEND PO FOR APPROVAL</h1>
                <button type="button" class="modal-close" data-bs-dismiss="modal" aria-label="Close">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>

            <div class="modal-body" id="approveModalBody">
            </div>

            <div class="modal-footer">
                <button type="button" class="offwhite_btn" id="sendForApprovalBtn">Send For Approval</button>
            </div>
        </div>
    </div>
</div>