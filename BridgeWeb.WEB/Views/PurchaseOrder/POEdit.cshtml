 @model BridgeWeb.Domain.Model.MultipleModel
@{
    ViewData["Title"] = $"{Model.RequiredPODetails.GeneratedPONumber}";
}


<!-- breadcrumb -->
<div class="bread_cumb_wrp">
    <div class="container-fluid">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="@Url.Action("Dashboard", "Home")">Home</a></li>
                <li class="breadcrumb-item"><a href="@Url.Action("POList", "PurchaseOrder")">PURCHASE ORDER</a></li>
                <li class="breadcrumb-item active" aria-current="page"><span>EDIT PURCHASE ORDER</span></li>
            </ol>
        </nav>
    </div>
</div>
<!-- breadcrumb -->
@* hidden fields start *@

<input type="hidden" value="@ViewBag.POId" id="Hdn_PurchaseOrderID" />
<input type="checkbox" id="Chk_hidden1" hidden @(Model.RequiredPODetails.IsHidden == true ? "checked" : "") />
<input type="hidden" value="@(Model.RequiredPODetails.IsCommitted ==true ? 1:0)" id="Hdn_iscommited" ) />
<input type="hidden" value="@(Model.RequiredPODetails.IsApproved ==true ? 1:0)" id="hdn_IsApproved" />
<input type="hidden" value="@(Model.RequiredPODetails.IsSentForApproval ==true ? 1:0)" id="hdn_IsSentForApproval" />
<input type="hidden" value="@Model.RequiredPODetails.LineItemCount" id="hdn_lineItemCount" />
<input type="hidden" value="@Model.RequiredPODetails.UserType" id="hdn_isUsertype" />
<input type="hidden" id="hdn_InvoiceStatus" value="" />
<input type="hidden" id="Hdn_Povalue" />
<input type="hidden" id="Hdn_IsEditable" value="@ViewBag.IsEditable" />
<input type="hidden" id="Hdn_CreatePOPermission" value="@(Model.RequiredPODetails.CreatePOPermission ==true ? 1:0)" />
<input type="hidden" id="Hdn_ProjectId" value="@(Model.RequiredPODetails.ProjectId)" />
<input type="hidden" id="Hdn_GeneratedPONumber" value="@Model.RequiredPODetails.GeneratedPONumber" />
<input type="hidden" id="Hdn_isConfirmed" value="@(Model.RequiredPODetails.IsConfirmed==true ?1:0)" />
<input type="hidden" id="Hdn_approveforvendor" value="@(Model.RequiredPODetails.approveForVendor)" />
<input type="hidden" id="Hdn_vendorname" value="@(Model.RequiredPODetails.VendorName?.Split("-")[1] ?? string.Empty)" />
<input type="hidden" id="Hdn_IsVendorConfirmation" value="" />


@* hidden fields end *@

<!-- flote icon -->
<div class="flote_icon">
    <ul>
        <li>
            <a href="javascript:void(0);" class="global-popover d-none" data-bs-toggle="popover" data-bs-trigger="hover"
               data-bs-content="Edit Check Back Date and/or Note" id="btn_SavePO">
                <i class="fa-regular fa-floppy-disk"></i>
            </a>
        </li>

        <li>
            <a href="javascript:void(0);" class="global-popover d-none" data-bs-toggle="popover" data-bs-trigger="hover"
               data-bs-content="Save PO" id="btn_CreatePO">
                <i class="fa-regular fa-floppy-disk"></i>
            </a>
        </li>
        <li>
            <a href="javascript:void(0);" class="global-popover" data-bs-toggle="popover" data-bs-trigger="hover" data-bs-content="Copy PO" id="btn_CopyPO">
                <i class="fa-regular fa-copy"></i>
            </a>
        </li>
        <li>
            <a href="javascript:void(0);" class="global-popover" data-bs-toggle="popover" data-bs-trigger="hover"
               data-bs-content="Move to next PO" id="moveNext">
                <i class="fa-solid fa-arrow-right"></i>
            </a>
        </li>
        <li>
            <a href="javascript:void(0);" class="global-popover" data-bs-toggle="popover" data-bs-trigger="hover"
               data-bs-content="Move to previous PO" id="movePrevious">
                <i class="fa-solid fa-arrow-left"></i>
            </a>
        </li>
        <li>
            <a href="javascript:void(0);" class="global-popover" data-bs-toggle="popover" data-bs-trigger="hover" data-bs-content="Cancel" id="cancelBtn">
                <i class="fa-solid fa-xmark"></i>
            </a>
        </li>
    </ul>
</div>
<!-- flote icon -->
<!-- poedti section -->
<section class="master_wrap poedit">
    <div class="container-fluid">
        <div class="accordion" id="accordionExample">
            <div class="poedti-accordian-wrp">
                <h2 class="accordion-header">
                    <button class="section_header collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseOne"
                            aria-expanded="false" aria-controls="collapseOne" id="PODetailsCollapse">
                        @Model.RequiredPODetails.GeneratedPONumber - @Model.RequiredPODetails.VendorName @Model.RequiredPODetails.Remarks
                    </button>
                </h2>

                <div id="collapseOne" class="accordion-collapse collapse " data-bs-parent="#accordionExample">
                    <div class="accordion-body">
                        <div id="PODetails"></div>

                    </div>
                </div>
            </div>
        </div>

        <div class="line_item_btns">
            <h2 class="section_header">LINE ITEMS</h2>
            <div class="row custom_gutter5-x">
                <div class="col-lg-6">
                    <div class="btn_grp">
                        <button type="button" data-toggle="tooltip" class="sky_btn gray_checkbtn" id="btn_RevisePO">Revise Commited PO</button>
                        <button type="button" data-toggle="tooltip" class="sky_btn gray_checkbtn" id="btn_CommitPO">Commit PO</button>
                        <button type="button" class="sky_btn gray_checkbtn" id="btn_CommitPONSndApprvl">Send for approval</button>
                        <button type="button" class="sky_btn gray_checkbtn" id="btn_CancelSendPONSndApprvl">Cancel Sending</button>
                        <button type="button" class="sky_btn gray_checkbtn" id="btn_CommitPONSndApprvl1">Send for approval</button>
                        <button type="button" class="sky_btn gray_checkbtn" id="btn_ProofPONSndApprvl">Proof PO</button>
                        <button type="button" class="sky_btn gray_checkbtn" id="btn_ViewPOPDF">View PDF</button>
                    </div>
                </div>
                <div class="col-lg-6">
                    <div class="btn_grp btn_grp_right">
                        <button type="button" class="gray_checkbtn" id="AddLineItemPO">Add Line Item PO</button>
                        <button type="button" class="gray_checkbtn" id="toggle-expand-all">Expand All</button>
                        <button type="button" class="gray_checkbtn" id="btn_SaveAll">Save All</button>
                    </div>
                </div>
                <div class="col-lg-6" style="display:none;" id="removemultiple">
                    <div class="btn_grp">

                        <button type="button" class="gray_checkbtn" id="deleteMultiple">
                            &nbsp; <i class="fa fa-trash-o"></i>&nbsp;&nbsp;Delete
                            selected Items
                        </button>

                        <button type="button" class="gray_checkbtn" id="cancelselections">
                            &nbsp; <i class="fa fa-times-circle"></i>&nbsp;&nbsp;Cancel all selections
                        </button>

                        <button type="button" class="gray_checkbtn" id="dragger" data-bs-target="#reorder_modal" data-bs-toggle="modal">
                            &nbsp; <i class="fa fa-bars"></i>&nbsp;&nbsp;Re-order
                            Item
                        </button>
                    </div>
                </div>

            </div>
        </div>
        <section class="poedit_sec">
            <div class="table-responsive-xl">
                <div id="polineitemtable"></div>


            </div>

            <hr>

            <table class="table summey_table" style="width: auto;">
                <tbody>
                    <tr>
                        <td>
                            Total invoiced value:-
                        </td>
                        <td style="text-align:right">
                            <label id="invval">@Model.POInvoiceCalculation.TotalInvoiceAmount</label>
                        </td>
                    </tr>
                    <tr>
                        <td>
                            Total invoiced tax:-
                        </td>
                        <td style="text-align:right">
                            <label id="invtx">@Model.POInvoiceCalculation.TotalInvoiceTax</label>
                        </td>

                    </tr>
                    <tr>
                        <td>
                            Total:-
                        </td>
                        <td style="text-align:right">
                            <label id="invtot">@(Model.POInvoiceCalculation.TotalInvoiceAmount + Model.POInvoiceCalculation.TotalInvoiceTax) </label>
                        </td>
                    </tr>
                </tbody>
            </table>

        </section>
    </div>
</section>
<!-- poedit section-->
