@{
    ViewData["Title"] = "PO History";
    string poid = ViewBag.POId as string ?? "";
}
@model MultipleModel

<!-- breadcrumb -->
<div class="bread_cumb_wrp">
    <div class="container-fluid">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="@Url.Action("Dashboard", "Home")">Home</a></li>
                <li class="breadcrumb-item"><a href="@Url.Action("POList", "PurchaseOrder")">PURCHASE ORDERS</a></li>
                <li class="breadcrumb-item active" aria-current="page"><span>PURCHASE ORDER HISTORY</span></li>
            </ol>
        </nav>
    </div>
</div>
<!-- breadcrumb -->
<!-- Search Purchase Order section -->
<section class="master_wrap po-history-wrp">
    <div class="container-fluid">
        <h2 class="section_header">PURCHASE ORDER HISTORY</h2>
        <table id="po_history_table" class="table table-striped table-hover" style="width:100%;table-layout: fixed;">
            <thead>
                <tr>
                    <th>Action</th>
                    <th>PO #</th>
                    <th>Vendor</th>
                    <th>Buyer</th>
                    <th>Ship Date</th>
                    <th>CheckBack Date</th>
                    <th>Vendor (C/O)</th>
                    <th>Created Date</th>
                    <th>Version</th>
                    <th>Added By</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.POHistoryDetails)
                {
                    var version = "";
                    var HistoryIcon = "";
                    var parts = poid.Split('|');
                    var type = parts.Length > 1 ? parts[1] : "";

                    if (type == "POREJECT")
                    {
                        if(item.FldID != 0)
                        {
                            version = item.Version;
                            HistoryIcon = $"<i style='margin-left:10px; cursor: pointer;' class='fa fa-history btn-action btn-history'  data-poid='{item.PurchaseOrderID}' data-version='{item.Version}' title='View Reject History'></i>";
                        }
                        else
                        {
                            version = item.Version + " (Current)";
                            HistoryIcon = $"<i style='margin-left:10px; cursor: pointer;' class='fa fa-history btn-action btn-history'  data-poid='{item.PurchaseOrderID}' data-version='{item.Version}' title='View Reject History'></i>";
                        }
                    }
                    else 
                    {
                        if (item.FldID != 0)
                        {
                            version = item.Version;
                            HistoryIcon = $"<i style='margin-left:10px; cursor: pointer;' class='fa fa-history btn-action openpohistory'  data-poid='{item.PurchaseOrderID}'  data-levelstatus='{item.LevelStatus}' data-version='{item.Version}' title='View Approval History'></i>";
                        }
                        else
                        {
                            version = item.Version + " (Current)";
                            HistoryIcon = $"<i style='margin-left:10px; cursor: pointer;' class='fa fa-history btn-action openpohistory2'  data-poid='{item.PurchaseOrderID}' data-levelstatus='{item.LevelStatus}' data-version='{item.Version}' title='View Approval History'></i>";
                        }
                    }

                    <tr>
                        <td>
                            <i class="fa fa-list btn-action" title="View Items" style="cursor:pointer;" btn-viewitems data-poid="@item.PurchaseOrderID" data-fldid="@item.FldID"></i>
                            @Html.Raw(HistoryIcon)
                            <i style="margin-left:10px;cursor:pointer;" class="fa fa-info-circle btn-action" btn-info data-poid="@item.PurchaseOrderID" data-version="@item.Version"></i>
                        </td>
                        <td>@item.PurchaseOrderNumber</td>
                        <td>@item.VendorName</td>
                        <td>@item.BuyerName</td>
                        <td>@item.ArrivalDate</td>
                        <td>@item.CheckBackDate</td>
                        <td>@item.VendorCOName</td>
                        <td>@item.InsertDate</td>
                        <td>@version</td>
                        <td>@item.AddedByName</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>
<!-- Purchase Order section-->

  <!-- Modal -->
  <div class="modal fade" id="line_item_modal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
      <div class="modal-content">
        <div class="modal-header">
          <h1 class="modal-title">Line Items</h1>
          <button type="button" class="modal-close" data-bs-dismiss="modal" aria-label="Close">
            <i class="fa-solid fa-xmark"></i>
          </button>
        </div>

        <div class="modal-body">
          <div id="poHistoryLineItems"></div>
        </div>

        <div class="modal-footer">
          <button type="button" class="offwhite_btn" data-bs-dismiss="modal">Close</button>
        </div>
      </div>
    </div>
  </div>

  <div class="modal fade" id="all_history_modal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
      <div class="modal-content">
        <div class="modal-header">
          <h1 class="modal-title">History</h1>
          <button type="button" class="modal-close" data-bs-dismiss="modal" aria-label="Close">
            <i class="fa-solid fa-xmark"></i>
          </button>
        </div>

        <div class="modal-body" id="all_history_modal_tbody"></div>

        <div class="modal-footer">
          <button type="button" class="offwhite_btn" data-bs-dismiss="modal">Close</button>
        </div>
      </div>
    </div>
  </div>

  <div class="modal fade" id="history_details_modal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl">
      <div class="modal-content">
        <div class="modal-header">
                <h1 class="modal-title" id="historydetailsheader"></h1>
                <button type="button" class="modal-close" data-bs-toggle="modal" data-bs-target="#all_history_modal" aria-label="Close">
            <i class="fa-solid fa-xmark"></i>
          </button>
        </div>

        <div class="modal-body" id="history_details_tbl"></div>

        <div class="modal-footer">
            <button type="button" class="offwhite_btn" data-bs-target="#all_history_modal" data-bs-toggle="modal">Close</button>
        </div>
      </div>
    </div>
  </div>

<div class="modal fade" id="po_Approval_history" tabindex="-1" aria-labelledby="exampleModalLabel"
     aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title">Approval History</h1>
                <button type="button" class="modal-close" data-bs-dismiss="modal" aria-label="Close">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>
            <div class="modal-body  approval_history_progress">
                <div id="partailPoApprovalHistory">
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" data-bs-dismiss="modal" class="offwhite_btn">Close</button>
            </div>
        </div>
    </div>
</div>

<!--PO Approval  History Modal POPup-->
<div class="modal fade" id="po_bck_Approval_history" tabindex="-1" aria-labelledby="exampleModalLabel"
     aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title">Approval History</h1>
                <button type="button" class="modal-close" data-bs-dismiss="modal" aria-label="Close">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>
            <div class="modal-body  approval_history_progress">
                <div id="partail_bck_PoApprovalHistory">
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" data-bs-dismiss="modal" class="offwhite_btn">Close</button>
            </div>
        </div>
    </div>
</div>