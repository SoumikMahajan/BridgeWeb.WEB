@{
    ViewData["Title"] = "Reports";
}

@model BridgeWeb.Domain.Model.MultipleModel

@{
    var menuOrderRaw = Model.singleResult?? "";
    var isAdmin = string.IsNullOrWhiteSpace(menuOrderRaw); // if blank, it's admin
    var menuOrder = isAdmin
        ? new List<string> { "B", "P", "S", "A" }  // full access
        : menuOrderRaw.Split('^', StringSplitOptions.RemoveEmptyEntries).Select(x => x.Trim()).ToList();
    bool showB = menuOrder.Contains("B");
    bool showP = menuOrder.Contains("P");
    bool showS = menuOrder.Contains("S");
    bool showA = menuOrder.Contains("A");
    var activeTab = string.IsNullOrEmpty(Model.ActiveTab) ? "B" : Model.ActiveTab;
}

<!-- breadcrumb -->
<div class="bread_cumb_wrp">
    <div class="container-fluid">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="@Url.Action("Dashboard", "Home")">Home</a></li>
                <li class="breadcrumb-item active" aria-current="page"><span>Report</span></li>
            </ol>
        </nav>
    </div>
</div>
<!-- breadcrumb -->
<!-- flote icon -->
<div class="flote_icon">
    <ul>
        <li>
            <a href="#" data-bs-toggle="popover" data-bs-content="Export To PDF Report" data-bs-trigger="hover" class="exportToPDF" data-format="PDF">
                <i class="fa-regular fa-file-pdf"></i>
            </a>
        </li>
        <li>
            <a href="#" data-bs-toggle="popover" data-bs-content="Export To Excel Report" data-bs-trigger="hover" class="exportToPDF" data-format="EXCELOPENXML">
                <i class="fa-regular fa-file-excel"></i>
            </a>
        </li>
    </ul>
</div>
<!-- flote icon -->
<!-- Report section -->
<section class="master_wrap report_sec">
    <div class="container-fluid">
        <h2 class="section_header">REPORTS</h2>

        <div class="row">
            <div class="col-md-3">
                <div class="multi_slc_wrp">
                    <label for="" class="form-label">Project<span class="req">*</span></label>
                    <select multiple="multiple" class="multislct" data-width="100%" id="txt_Project">
                        @foreach (var item in Model.ReportProjectList)
                        {
                            <option value="@item.ProjectID">@item.ProName</option>
                        }
                    </select>
                </div>
            </div>
        </div>

        <div class="tab_container">
            <ul class="nav nav-tabs" role="tablist" id="myTab">
                @if (showB)
                {
                    <li class="nav-item" role="presentation">
                        <button class="nav-link @(activeTab == "B" ? "active" : "")" data-bs-toggle="tab" data-bs-target="#systab1" type="button" role="tab"
                                aria-selected="true">
                            BUDGET
                        </button>
                    </li>
                }

                @if (showP)
                {
                    <li class="nav-item" role="presentation">
                        <button class="nav-link @(activeTab == "P" ? "active" : "")" data-bs-toggle="tab" data-bs-target="#systab2" type="button" role="tab"
                                aria-selected="true">
                            PURCHASE COMMITMENT
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#systab3" type="button" role="tab"
                                aria-selected="false">
                            COMMITTED COST
                        </button>
                    </li>
                }

                @if (showS)
                {
                    <li class="nav-item" role="presentation">
                        <button class="nav-link @(activeTab == "S" ? "active" : "")" data-bs-toggle="tab" data-bs-target="#systab4" type="button" role="tab"
                                aria-selected="false" id="statusReport">
                            STATUS
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#systab5" type="button" role="tab"
                                aria-selected="false">
                            Fabrication Approval
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#systab6" type="button" role="tab"
                                aria-selected="false">
                            RECEIVING
                        </button>
                    </li>
                }
                               
                @if (showA)
                {
