                        <button class="nav-link @(activeTab == "A" ? "active" : "")" data-bs-toggle="tab" data-bs-target="#systab7" type="button" role="tab"
                                aria-selected="false">
                            PO
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#systab8" type="button" role="tab"
