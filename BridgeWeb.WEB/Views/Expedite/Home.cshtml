@model MultipleModel
@{
    ViewData["Title"] = "Expedite Dashboard";
    //var CanAdd = Model.expediteHiddenFields.HdnAddPermission;
    var CanEdit = Model.expediteHiddenFields.HdnEditPermission;
    var AddPermission = Model.expediteHiddenFields.HdnAddPermission == "1" ? "" : "disabled";
    var EditPermission = CanEdit == "1" ? "" : "disabled";
}

<!-- breadcrumb -->
<div class="bread_cumb_wrp">
    <div class="container-fluid">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="@Url.Action("Dashboard", "Home")">Home</a></li>
                <li class="breadcrumb-item active" aria-current="page"><span>EXPEDITE</span></li>
            </ol>
        </nav>
    </div>
</div>
<!-- breadcrumb -->
<!-- Hidden field -->

<input type="hidden" id="Hdn_IsUserType" value="@Model.expediteHiddenFields.HdnUserType" />
<input type="hidden" id="Hdn_IsVendor" value="@Model.expediteHiddenFields.HdnIsVendor" />

<input type="hidden" id="Hdn_EditPermission" value="@Model.expediteHiddenFields.HdnEditPermission" />
<input type="hidden" id="Hdn_AddPermission" value="@Model.expediteHiddenFields.HdnAddPermission" />
<input type="hidden" id="Hdn_EditHistoryPermission" value="@Model.expediteHiddenFields.HdnIsAllowEditHistory" />

<input type="hidden" id="Hdn_Filter" />
<input type="hidden" id="Hdn_POLineItemID" />
<input type="hidden" id="Hdn_PurchaseOrderID" />
<input type="hidden" id="Hdn_IsManager" />
<input type="hidden" id="Hdn_LineObj" />
<input type="hidden" id="Hdn_PORequiredDate" />
<input type="hidden" id="Hdn_ItemStatus" />

<input type="hidden" id="HiddenClause" />

<!-- Hidden field -->
<!-- Expedite section -->
<section class="master_wrap expledite">
    <div class="container-fluid">
        <div class="row custom_gutter5-x">
            <div class="col-lg-4">
                <h2 class="section_header">EXPEDITE</h2>
                <div class="multi_slc_wrp">
                    <label for="" class="form-label">Select Project</label>
                    <select multiple="multiple" class="multislct" data-width="100%" id="projectDD">
                        @if (Model.dropDownListDTOs != null)
                        {
                            @foreach (var item in Model.dropDownListDTOs)
                            {
                                <option data-id="@item.Id" value="@item.Id">@item.Name</option>
                            }
                        }
                    </select>
                </div>
            </div>
            <div class="col-lg-8">
                <h2 class="section_header">ADVANCED SEARCH</h2>
                <div class="row custom_gutter5-x">
                    <div class="col-lg-3">
                        <div class="frm_fld_wrp">
                            <label for="" class="form-label">Select Criteria</label>
                            <select class="TakeVal displayon form-select" id="FirstSearchDdlLeft"></select>
                        </div>
                        <div class="frm_fld_wrp">
                            <select class="TakeVal displayon form-select" id="FirstSearchDdlRight"></select>
                        </div>
                    </div>
                    <div class="col-lg-3">
                        <div class="frm_fld_wrp">
                            <label for="" class="form-label">Select Parameter</label>
                            <select class="form-select" id="SecondSearchDdlLeft"></select>
                        </div>
                        <div class="frm_fld_wrp">
                            <select class="form-select" id="SecondSearchDdlRight"></select>
                        </div>
                    </div>
                    <div class="col-lg-3">
                        <div class="frm_fld_wrp">
                            <label for="" class="form-label">Select Value</label>

                            <input class="ThirdSearchDdlLefttxt displayoff form-control" id="ThirdSearchDdlLefttxt" />

                            <input class="displayoff form-control" id="ThirdSearchDdlLeftDtPckr" autocomplete="off" />

                            <select class="ThirdSearchDdlLeftddl form-select" id="ThirdSearchDdlLeft"></select>
                        </div>
                        <div class="frm_fld_wrp">
                            <input class="ThirdSearchDdlRighttxt displayoff form-control" id="ThirdSearchDdlRighttxt" />

                            <input class="displayoff form-control" id="ThirdSearchDdlRightDtPckr" autocomplete="off" />

                            <select class="ThirdSearchDdlRightddl form-select" id="ThirdSearchDdlRight"></select>
                        </div>
                    </div>
                    <div class="col-lg-3">
                        <div class="and_or">
                            <label for="chk_and"><input type="radio" id="chk_and" value="and" name="and_or_redio" checked> and</label>
                            <label for="chk_or"><input type="radio" id="chk_or" value="or" name="and_or_redio"> or</label>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="exp_acc_wrp">
            <div class="row">
                <div class="col-12">

                    <div class="accordion byvendor_acc" id="first_level">
                        <div class="accordion-item">
                            <h2 class="accordion-header">
                                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#accVendor"
                                        aria-expanded="false" aria-controls="accVendor">
                                    <div class="byvendor">
                                        By Vendor <span id="vendorCount">(@(ViewBag.VendorCount is null ? 0 : ViewBag.VendorCount))</span>
                                    </div>
                                    <i class="fa-solid fa-arrows-rotate ref_table" id="vendorRefresh" title="Refresh"></i>
                                </button>
                            </h2>
                            <div id="accVendor" class="accordion-collapse collapse" data-bs-parent="#first_level"></div>
                        </div>
                    </div>

                    <div class="accordion bybudget_acc" id="budget_level" style="@(Model.expediteHiddenFields.HdnIsVendor == "Y" ? "display:none" : "")">
                        <div class="accordion-item">
                            <h2 class="accordion-header">
                                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#accBudget"
                                        aria-expanded="true" aria-controls="accBudget">
                                    <div class="byvendor">
                                        By Budget Section <span id="sectionCount">(0)</span>
                                    </div>
                                    <i class="fa-solid fa-arrows-rotate ref_table" id="budgetRefresh" title="Refresh"></i>
                                </button>
                            </h2>
                            <div id="accBudget" class="accordion-collapse collapse" data-bs-parent="#budget_level"></div>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
</section>
<!-- Expedite section-->
<!-- float icon -->
<div class="flote_icon">
    <ul>
        <li>
            <a href="javascript:void(0);" title="Filter" id="applyFilter"><i class="fa-solid fa-filter"></i></a>
        </li>
        <li>
            <a href="javascript:void(0);" title="Reset" id="clearFilterBtn"><i class="fa-solid fa-xmark"></i></a>
        </li>
    </ul>
</div>
<!-- float icon -->
<!-- Modal -->
<div class="modal fade" id="note_modal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-md">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title">PO NOTES</h1>
                <button type="button" class="modal-close" data-bs-dismiss="modal" aria-label="Close">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>
            <div class="modal-body">
                <div class="expdite_note">
                    <div class="frm_fld_wrp">
                        <label for="" class="form-label">PO Expedite Notes</label>
                        <textarea class="form-control" id="POItemExpediteNotemodal"></textarea>
                    </div>
                    <button type="button" class="save_po_btn solid_teal_btn" id="btn_AddOnlyExpNote">
                        <i class="fa-regular fa-square-plus"></i> Save PO
                        Note
                    </button>
                    <div class="col-lg-12">
                        <input type="hidden" id="hdn_poid" />
                        <div id="poexpnoteinExpHistory">
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="offwhite_btn" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="po_itm_exp_note" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
