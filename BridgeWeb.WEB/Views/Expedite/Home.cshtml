                                </tbody>
                            </table>
                        </div>
                        <div class="po_exp_note">
                            <h2 class="section_header">PO EXPEDITE NOTES</h2>
                            <div class="row">
                                <div class="col-lg-6 lft_col">
                                    <div class="frm_fld_wrp">
                                        <label class="form-label">PO Expedite Notes</label>
                                        <textarea class="form-control" @AddPermission></textarea>
                                    </div>
                                    <button type="button" class="save_po_btn solid_teal_btn" @AddPermission>
