<div class="modal fade" id="edit_exp_modal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-md">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title">Edit Expedite Notes</h1>
                <button type="button" class="modal-close" data-bs-dismiss="modal" aria-label="Close">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>
            <div class="modal-body">
                <form action="#" class="edit_exp">
                    <div class="frm_fld_wrp">
                        <select id="user_type" class="form-select">
                            <option selected="">On Track</option>
                            <option>At Risk</option>
                            <option>In Transit</option>
                            <option>Received</option>
                        </select>
                    </div>
                    <div class="frm_fld_wrp">
                        <label for="user_type" class="form-label">Note</label>
                        <input type="text" class="form-control">
                    </div>
                    <div class="frm_fld_wrp">
                        <label for="user_type" class="form-label">Qty</label>
                        <input type="text" class="form-control">
                    </div>
                    <div class="frm_fld_wrp">
                        <label for="user_type" class="form-label">R-Date</label>
                        <input type="text" class="form-control datepicker">
                    </div>
                    <div class="frm_fld_wrp">
                        <label for="user_type" class="form-label">Ref</label>
                        <input type="text" class="form-control">
                    </div>

                    <button type="button" class="gray_checkbtn">Save</button>
                </form>
            </div>
        </div>
    </div>
</div>

