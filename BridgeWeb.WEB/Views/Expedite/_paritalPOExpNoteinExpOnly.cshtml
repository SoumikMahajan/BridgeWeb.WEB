@model BridgeWeb.Domain.Model.MultipleModel
@{
    var EditPermission = Model.expediteHiddenFields.HdnEditPermission;
    var AddPermission = Model.expediteHiddenFields.HdnAddPermission;
}
<table style="width: 100%;" class="table tblPOExpediteHistory" id="">
    <thead>
        <tr>
            @if (EditPermission == "1")
            {
                <th>Action</th>
                // If IsSelected is 1 then show this else don't show, same for other fields where (if block) is applied
            }
            <th>Created By</th>
            <th>Notes</th>
            <th>Added on</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.POExpediteNoteList.Count() > 0)
        {
            foreach (var items in Model.POExpediteNoteList)
            {
                <tr>
                    @if (EditPermission == "1")
                    {

                        <td>
                            <a href="javascript:void(0);" data-bs-toggle="modal" class="poexphistoryonly" data-id="@items.FldID" data-bs-target="#popupforeditponote1">
                                <i class="fa fa-pencil-square-o"></i>
                            </a>
                            <a href="javascript:void(0);" data-id="@items.FldID" class="deletepoexpnoteonly">
                                <i class="fa fa-trash-o mrg5L"></i>
                            </a>
                        </td>
                    }
                    <td>@items.Name</td>
                    <td>@items.Notes</td>
                    <td>@items.CreatedDate</td>
                </tr>
            }
        }
        else
        {
            <tr><td colspan="4" class="empty_cell" style='color:black'>No Expedite History Found</td></tr>
        }
    </tbody>
</table>