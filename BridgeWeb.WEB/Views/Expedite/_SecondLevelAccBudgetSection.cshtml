@using BridgeWeb.Domain.Model.Dto.Expedite
@model List<BudgetLineItemsDto_Expedite>

<div class="accordion-body">
    @{
        int index = 0;
        var IsPoEditAccessPermission = @ViewBag.IsEditable;
    }
    @foreach (var po in Model)
    {
        <div class="accordion accordion_lev_third" id="budget_third_level">
            <div class="accordion-item">
                <h2 class="accordion-header">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse"
                            data-bs-target="#acc_@po.LineItemID" aria-expanded="false" aria-controls="acc_@po.LineItemID">
                        <table class="table table-striped table-hover" style="width:100%">
                            @if (index == 0)
                            {
                                <thead>
                                    <tr>
                                        <th style="width:25%;">Item#</th>
                                        <th style="width:25%;">Spec</th>
                                        <th style="width:25%;">Description</th>
                                        <th></th>
                                    </tr>
                                </thead>
                            }
                            <tbody>
                                <tr>
                                    <td style="width:25%;">@po.ItemNumber</td>
                                    <td style="width:25%;">@po.SpecNum</td>
                                    <td style="width:25%;">@po.ItemDescription</td>
                                    <td>(@po.Description.Count)</td>
                                </tr>
                            </tbody>
                        </table>
                    </button>
                </h2>
                <div id="acc_@po.LineItemID" class="accordion-collapse collapse" data-bs-parent="#budget_third_level">
                    <div class="accordion-body">
                        <div class="table-responsive">
                            <table class="table table-striped table-hover" style="width:100%">
                                <thead>
                                    <tr>
                                        <th>Action</th>
                                        <th>PO Number</th>
                                        <th>Vendor</th>
                                        <th>Vendor CO</th>
                                        <th>Payment Sch.</th>
                                        <th>FOB</th>
                                        <th>Arrival Date</th>
                                        <th>Check back</th>
                                        <th>Item Status</th>
                                        @* <th>Inv</th> *@
                                        <th>PO Qty</th>
                                        <th>R-Qty</th>
                                        <th>Ship Via</th>
                                        <th>Ship To</th>
                                        <th>Freight</th>
                                        <th>Remarks</th>
                                        <th>Committed</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var li in po.Description)
                                    {
                                        var poId = @li.POID?.Split('#')[0] ?? "";
                                        var PoNumber = @li.POID?.Split('#')[1] ?? "";
                                        var Numofexpnotes = "";
                                        if (li.cnt > 0)
                                        {
                                            Numofexpnotes = $"<i class='fa fa-asterisk mrg10L' aria-hidden='true' style='cursor: pointer;' title='This item has {li.cnt} notes'></i>";
                                        }
                                        <tr>
                                            <td>
                                                <a class="expNotebtn" href="javascript:void(0);" data-lineitemnumber="@PoNumber" data-lineitemid="@li.POLineItemID" data-qty="@Math.Round(li.Qty.Value, 0)"
                                                   data-rqty="@Math.Round(li.ReceivedQuantity.Value, 0)" data-ponumber="@PoNumber" data-bs-target="#po_exp_note" data-poid="@poId" data-bs-toggle="modal" style="cursor: pointer; color: black;">
                                                    <i class="fa-regular fa-pen-to-square edit_vendor_po_item "></i>
                                                </a>

                                                @Html.Raw(Numofexpnotes)
                                            </td>
                                            <td style="width:8%;">
                                                @if (IsPoEditAccessPermission == "0")
                                                {                                                   
                                                    <a href="javascript:void(0)" data-poid="@poId" class="gotoPOReport">
                                                        @PoNumber
                                                    </a>
                                                }
                                                else
                                                {
                                                    <a href="@Url.Content("/PurchaseOrder/POEdit?POId=" + @poId)" target="_blank">@PoNumber</a>
                                                }
                                                
                                                
                                            </td>
                                            <td>@li.VendorName</td>
                                            <td>@li.VendorCO</td>
                                            <td>@li.Terms</td>
                                            <td>@li.FOB</td>
                                            <td>@li.ArrivalDate</td>
                                            <td>@li.CheckBackDate</td>
                                            <td>@li.ItemStatus</td>
                                            @* <td>@li.Inv</td> *@
                                            <td>@li.Qty</td>
                                            <td>@li.ReceivedQuantity</td>
                                            <td>@li.ShipMethod</td>
                                            <td>@li.ShipTo</td>
                                            <td>@li.Freight</td>
                                            <td>@li.Remarks</td>
                                            <td>@li.IsCommitted</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        index++;
    }
</div>