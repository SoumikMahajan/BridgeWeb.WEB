@model BridgeWeb.Domain.Model.MultipleModel

<table class="table table-striped table-hover" id="fav_appr_table" style="width: 100%;">
    <thead>
        <tr>
            <th>Action</th>
            <th>Fabrication Approval Name</th>
            <th>Fabrication Short Name</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model.itemApprovalsList)
        {
            <tr>
                <td class="action_tab">
                    <a href="#" data-bs-toggle="modal" data-bs-target="#exampleModal6" class="edit_modal" id="fab_edit"data-id="@item.ItemApprovalID">
                        <i class="fa-regular fa-pen-to-square"></i>
                    </a>
                    <i class="fa @(item.Status == "0" ? "fa-times-circle" : "fa-check-circle")"></i>
                </td>
                <td>@item.ItemName</td>
                <td>@item.ItemShortName</td>
            </tr>
        }
        
    </tbody>
</table>
