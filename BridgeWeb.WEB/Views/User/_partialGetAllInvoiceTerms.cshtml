@model BridgeWeb.Domain.Model.MultipleModel

<table id="invoice_term_tabl" class="table table-striped table-hover sys_admn_tabl"
       style="width:100%">
    <thead>
        <tr>
            <th>Action</th>
            <th>Terms</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.vendorTermsList)
        {
            <tr>
                <td class="action_tab">
                    <a href="#" data-bs-toggle="modal" data-bs-target="#exampleModal2" class="edit_modal" data-id="@item.TermID"  id="editButton">
                        <i class="fa-regular fa-pen-to-square" ></i>
                    </a>
                    <i class="fa @(item.Status == "0" ? "fa-times-circle" : "fa-check-circle")"></i>
                </td>
                <td>@item.Terms</td>
            </tr>
        }
    </tbody>  
    
</table>

