@model BridgeWeb.Domain.Model.MultipleModel

<table class="table table-striped table-hover" id="fav_uom_table" style="width: 100%;">
    <thead>
        <tr>
            <th>Action</th>
            <th>Default</th>
            <th>CurrencyCode</th>
        </tr>
    </thead>

    <tbody>
        @if (Model.uomList.Count > 0)
        {
            foreach (var item in Model.uomList)
            {
                <tr>
                    <td class="action_tab">
                        <a href="#" data-bs-toggle="modal" data-bs-target="#editUom" class="edit_modal" data-id="@item.UOM_ID" id="editModalUom">
                            <i class="fa-regular fa-pen-to-square"></i>
                        </a>
                        <i class="fa @(item.Status == 0 ? "fa-times-circle" : "fa-check-circle")"></i>
                    </td>
                    <td><i class="fa @(item.IsDefault == 0 ? "fa-times-circle" : "fa-check-circle")"></i></td>                        
                    <td>@item.UOM</td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="3" class="empty_cell">No data available in table</td>
            </tr>
        }
        
    </tbody>
</table>