@model BridgeWeb.Domain.Model.MultipleModel

<table class="table table-striped table-hover" id="table_currency" style="width: 100%;">
    <thead>
        <tr>
            <th>Action</th>
            <th>Currency</th>
            <th>CurrencyCode</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model.currencyList)
        {
            <tr>
                <td class="action_tab">
                    <a href="#" data-bs-toggle="modal" data-bs-target="#edit_currency" class="edit_modal" data-id="@item.CurrencyID" id="editCurrency">
                        <i class="fa-regular fa-pen-to-square"></i>
                    </a>
                    <i class="fa @(item.Status == false ? "fa-times-circle" : "fa-check-circle")"></i>
                </td>
                <td>@item.Currency</td>
                <td>@item.CurrencyCode</td>
            </tr>
        }                
    </tbody>
</table>