@model BridgeWeb.Domain.Model.MultipleModel

<table id="user_list_table" class="table table-striped table-hover user_list_table" style="width:100%">
    <thead>
        <tr>
            <th>Action</th>
            <th>Activation</th>           
            <th>User ID</th>
            <th>First Name</th>
            <th>Last Name</th>
            <th>E-mail</th>
            <th>User Type</th>
            <th>Buyer</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.systemUsersDTOs)
        {
            <tr>
                <td class="text-center">
                    <i class="fa-regular fa-hand-point-right pointer edituserlist " data-bs-toggle="modal"
                       data-bs-target="#update_contact_info" data-id="@item.FldID" id="btn-edit"></i>
                </td>
                @* @if (item.Isactive == true)
                {
                    <td class="activation"><i class="fa fa-check-circle"></td>
                }
                else
                {
                    <td class="activation displaynone"><i class="fa fa-times-circle"></td>
                } *@
                <td class="activation @(item.Isactive ?? false ? "" : "displaynone")">
                        <i class="fa @(item.Isactive ?? false ? "fa-check-circle" : "fa-times-circle") activeUser" data-id="@item.FldID" data-status="@item.Isactive"></i>
                </td>                
                
                <td class="usr_id" id="uId">@item.FldID</td>
                <td>@item.Firstname</td>
                <td>@item.Lastname</td>
                <td class="e-mail"><a href="mailto:@item.Email">@item.Email</a></td>
                <td>@item.SystemUserType</td>
                <td>@(item.Isbuyer ?? false ? "Yes" : "No")</td>
                <td>@item.Isactive</td>
                @* @if (item.Isbuyer == true)
                {
                    <td>Yes</td>
                }
                else
                {
                    <td>No</td>
                } *@
                
            </tr>
        }
              
    </tbody>
</table>