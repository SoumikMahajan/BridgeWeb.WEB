<div class="modal fade" id="refNumberEdit" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-md">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title">Add/Edit Ref</h1>
                <button type="button" class="modal-close" data-bs-dismiss="modal" aria-label="Close">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="flId" />
                <label for="refNo">Ref No</label>
                <input type="text" id="refNo" class="col-sm-12" />
            </div>
            <div class="modal-footer">
                <button type="button" class="gray_checkbtn" data-bs-dismiss="modal">Close</button>
                <button type="button" class="btn btn-success" id="saveRefNo">Save</button>
            </div>
        </div>
    </div>
</div>