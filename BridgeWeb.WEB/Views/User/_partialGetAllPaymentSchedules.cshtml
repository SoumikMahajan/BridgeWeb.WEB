@model BridgeWeb.Domain.Model.MultipleModel

<table class="table table-striped table-hover" id="pay_scdl" style="width: 100%;">
    <thead>
        <tr>
            <th>Action</th>
            <th>Terms</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.termsList)
        {
            <tr>
                <td class="action_tab">
                    <a href="#" data-bs-toggle="modal" data-bs-target="#exampleModal4" class="edit_modal" id="paySched" data-id="@item.TermID">
                        <i class="fa-regular fa-pen-to-square"></i>
                    </a>
                    @* <i class="fa-solid fa-circle-check"></i> *@
                    <i class="fa @(item.Status == false ? "fa-times-circle" : "fa-check-circle")"></i>
                    
                </td>
                <td>@item.Terms</td>
            </tr>
        }
        
       
    </tbody>    
</table>