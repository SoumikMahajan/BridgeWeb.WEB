@model BridgeWeb.Domain.Model.MultipleModel
<table class="table table-striped table-hover" id="table_bank_account" style="width: 100%;">
    <thead>
        <tr>
            <th>Action</th>
            <th>Number</th>
            <th>Desc</th>
            <th>Currency</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model.bankAccountList)
        {
            <tr>
                <td class="action_tab">
                    <a href="#" data-bs-toggle="modal" data-bs-target="#editBankAcc" class="edit_modal" data-id="@item.Fld_ID" id="editBankaccBtn">
                        <i class="fa-regular fa-pen-to-square"></i>
                    </a>
                    <i class="fa @(item.IsActive == false ? "fa-times-circle" : "fa-check-circle")"></i>
                </td>
                <td>@item.Bank_Account</td>
                <td>@item.Desc</td>
                <td>@item.CurrencyCode</td>
            </tr>
        }               
    </tbody>
</table>
