 </style> *@

<!-- breadcrumb -->
<div class="bread_cumb_wrp">
    <div class="container-fluid">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="@Url.Action("Dashboard", "Home")">Home</a></li>
                <li class="breadcrumb-item"><a href="#">System Admin</a></li>
                <li class="breadcrumb-item active" aria-current="page"><span>Add Client/Consultant</span></li>
            </ol>
        </nav>
    </div>
</div>
<!-- breadcrumb -->
<!-- add client form start -->
<section class="master_wrap add_client_wrp">
    <div class="container-fluid">
        <div class="custom_gutter5-x row">
            <div class="col-xl-5">
                <h2 class="section_header" id="usertypeselected">ADD NEW USER (Select User Type from DropDown)</h2>
                <form action="#" class="custom_gutter5-x new_client_frm row" id="create_client_form">
                    @Html.AntiForgeryToken()
                    <div class="col-lg-4">
                        <div class="frm_fld_wrp">
                            <label for="user_type" class="form-label">User Type</label>
                            <select id="user_type" class="form-select">
                                <option value="0">---Select UserType---</option>
                                @foreach (var item in Model.ProjectusertypeList)
                                {
                                    <option value="@item.Fldid">@item.Usertype</option>
                                }
                                @*  <option selected >Consultant</option>
                                <option>Consultant2</option>
                                <option>Consultant3</option> *@
                            </select>
                        </div>
                    </div>

                    <div class="col-lg-4">
                        <div class="frm_fld_wrp">
                            <label for="company_name" class="form-label">Company Name</label>
                            <input type="text" class="form-control" id="company_name" aria-label="Company Name">
                        </div>
                    </div>

                    <div class="col-lg-4">
                        <div class="frm_fld_wrp">
                            <label for="title" class="form-label">Title</label>
                            <input type="text" class="form-control" id="title" aria-label="Title">
                        </div>
                    </div>

                    <div class="col-lg-4">
                        <div class="frm_fld_wrp">
                            <label for="First_name" class="form-label">First Name<span class="req">*</span></label>
                            <input type="text" class="form-control" id="First_name" aria-label="First name">
                        </div>
                    </div>

                    <div class="col-lg-4">
                        <div class="frm_fld_wrp">
                            <label for="last_name" class="form-label">Last Name<span class="req">*</span></label>
                            <input type="text" class="form-control" id="last_name" aria-label="Last Name">
                        </div>
                    </div>

                    <div class="col-lg-4">
                        <div class="frm_fld_wrp">
                            <label for="email_addr" class="form-label">Email address<span class="req">*</span></label>
                            <input type="email" class="form-control" id="email_addr" aria-label="Email">
                        </div>
                    </div>

                    <div class="col-lg-4">
                        <div class="frm_fld_wrp">
                            <label for="phone" class="form-label">Phone</label>
                            <input type="number" class="form-control" id="phone" aria-label="Phone">
                        </div>
                    </div>

                    <div class="col-lg-4">
                        <div class="frm_fld_wrp">
                            <label for="phone_ext" class="form-label">Phone Ext.</label>
                            <input type="number" class="form-control" id="phone_ext" aria-label="Phone Ext.">
                        </div>
                    </div>

                    <div class="col-lg-6">
                        <div class="frm_fld_wrp">
                            <label for="address" class="form-label">Address</label>
                            <textarea class="form-control" id="address" rows="4"></textarea>
                        </div>
                        <div class="frm_fld_wrp">
                            <label for="city" class="form-label">City</label>
                            <input type="text" class="form-control" id="city" aria-label="City">
                        </div>
                    </div>

                    <div class="col-lg-6">
                        <div class="frm_fld_wrp">
                            <label for="Country" class="form-label">Country</label>
                            <select id="Country" class="form-select">
                                <option value="0" selected>--Select Country--</option>
                                @foreach (var item in Model.CountryList)
                                {
                                    <option value="@item.CountryID">@item.Country</option>
                                }

                            </select>
                        </div>
                        <div class="frm_fld_wrp">
                            <label for="state" class="form-label">State/Prov</label>
                            <select id="state" class="form-select">
                                @*  <option value="0">Select State</option>
                               @foreach(var item in Model.StateList)
                                {
                                    <option value="@item.StateID">@item.State</option>
                                } *@
                            </select>
                        </div>
                        <div class="frm_fld_wrp">
                            <label for="zip_code" class="form-label">Postal/Zip Code</label>
                            <input type="text" class="form-control postalcode" id="zip_code" aria-label="Postal/Zip Code">
                        </div>
                    </div>
                </form>
                @if (role.ToUpper() == "Administrator".ToUpper())
                {

                    <div class="d-flex align-items-center mt-1 gap-3">
                        <label class="d-flex align-items-center gap-2"><input type="checkbox" id="mfaenable">Enable Two-factor Authentication</label>
                    </div>
                }
