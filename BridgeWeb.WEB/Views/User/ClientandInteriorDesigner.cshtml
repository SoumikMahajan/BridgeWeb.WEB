@using System.Security.Claims
@{
    ViewData["Title"] = "Client and Interior Designer";
}
@model BridgeWeb.Domain.Model.MultipleModel
@{
    var role = User.Claims.FirstOrDefault(c => c.Type == ClaimTypes.Role)?.Value ?? "";
}
