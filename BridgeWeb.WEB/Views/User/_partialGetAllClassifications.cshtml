@model BridgeWeb.Domain.Model.MultipleModel

<table id="classification_tabl" class="table table-striped table-hover sys_admn_tabl"
       style="width:100%">
    <thead>
        <tr>
            <th>Action</th>
            <th>Classification</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.classificationsList)
        {
            <tr>
                <td class="action_tab">
                    <a href="#" data-bs-toggle="modal" data-bs-target="#classification_modal"
                       class="edit_modal" data-id="@item.Classification_ID" id="edit_classification">
                        <i class="fa-regular fa-pen-to-square"></i>
                    </a>
                    <i class="fa @(item.Status == "0" ? "fa-times-circle" : "fa-check-circle")"></i>
                </td>
                <td>@item.Classification</td>
            </tr>
        }
    </tbody>
</table>