@model BridgeWeb.Domain.Model.MultipleModel
<table class="table table-striped table-hover" id="ship_method_table" style="width: 100%;">
    <thead>
        <tr>
            <th>Action</th>
            <th>Shipment Method</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model.shipmentsList)
        {
            <tr>
                <td class="action_tab">
                    <a href="#" data-bs-toggle="modal" data-bs-target="#exampleModal5" class="edit_modal" id="shipEdit"data-id="@item.ShipID">
                        <i class="fa-regular fa-pen-to-square"></i>
                    </a>
                    <i class="fa @(item.Status ?? false ? "fa-check-circle" : "fa-times-circle")"></i>
                </td>
                <td>@item.ShipMethod</td>
            </tr>
        }              
    </tbody>
</table>
