

@model BridgeWeb.Domain.Model.MultipleModel



<div class="row">
    <div class="col-md-6">
        <div class="frm_fld_wrp">
            <label for="">Number</label>
            <input type="text" class="form-control" id="" placeholder="Bank Account Cannot Be Empty.">
        </div>
    </div>

    <div class="col-md-6">
        <div class="frm_fld_wrp">
            <label for="">Description</label>
            <input type="text" class="form-control" id="" placeholder="Enter Bank Account Desc.">
        </div>
    </div>

    <div class="col-md-6">
        <div class="frm_fld_wrp">
            <label for="">Currency</label>
            <select class="form-select">
                <option value="0">--Select Currency--</option>
                <option value="PoundSterling">Pound Sterling</option>
                <option value="CanadianDollar">Canadian Dollar</option>
                <option value="USDollar">US Dollar</option>
                <option value="Euro">Euro</option>
                <option value="Afghani">Afghani</option>
                <option value="AlgerianDinar">Algerian Dinar</option>
                <option value="ArgentinePeso">Argentine Peso</option>
                <option value="ArmenianDram">Armenian Dram</option>
            </select>
        </div>
    </div>

    <div class="col-md-6">
        <div class="inline_input">
            <label for="acti" class="inline_check">Active</label>
            <input type="checkbox" id="acti">
        </div>
    </div>
</div>