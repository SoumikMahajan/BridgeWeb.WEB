@model BridgeWeb.Domain.Model.MultipleModel

<table class="table table-striped table-hover invoice_term" id="invoice_term" style="width: 100%;">
    <thead>
        <tr>
            <th>Action</th>
            <th>Contact Type</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model.contactTypesList)
        {
            <tr>
                <td>
                    <a href="#" data-bs-toggle="modal" data-bs-target="#exampleModal3" class="edit_modal" id="contactType" data-id="@item.ContactTypeID">
                        <i class="fa-regular fa-pen-to-square"></i>
                    </a>
                </td>
                <td>@item.ContactType</td>
            </tr>
        }       
    </tbody>
</table>