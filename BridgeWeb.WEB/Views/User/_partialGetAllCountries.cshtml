@model BridgeWeb.Domain.Model.MultipleModel

<table class="table table-striped table-hover" id="table_countries" style="width: 100%;">
    <thead>
        <tr>
            <th>Action</th>
            <th>Country</th>
            <th>Country Code</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model.CountryList)
        {
            <tr>
                <td class="action_tab">
                    <a href="#" data-bs-toggle="modal" data-bs-target="#edit_country" class="edit_modal" data-id="@item.CountryID" id="editCountryButton">
                        <i class="fa-regular fa-pen-to-square"></i>
                    </a>
                    <i class="fa @(item.Status == "0" ? "fa-times-circle" : "fa-check-circle")"></i>
                </td>
                <td>@item.Country</td>
                <td>@item.CountryCode</td>
            </tr>
        }             
    </tbody>
</table>
